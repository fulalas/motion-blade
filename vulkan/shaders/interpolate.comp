#version 450
#extension GL_GOOGLE_include_directive : enable
#include "push_constants.h"
layout(push_constant) uniform Push { interpolate_push push; };
#include "warp.glsl"
#include "chroma.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 6) readonly buffer Cells { vec4 cells[]; };
layout(std430, binding = 7) readonly buffer Forward { vec4 forward[]; };
layout(std430, binding = 8) readonly buffer Backward { vec4 backward[]; };
layout(std430, binding = 14) readonly buffer Stats { uint stats[]; };
layout(std430, binding = 15) readonly buffer Fallback { float fallback_weights[]; };
layout(std430, binding = 16) readonly buffer Offsets { vec4 offsets[]; };
layout(std430, binding = 17) readonly buffer Panels { float panel_weights[]; };
layout(std430, binding = 18) readonly buffer Global { vec4 global_motion[]; };

#define MAX_CANDIDATES 5
#define SIDE_LEVELS 7.0
#ifdef NV
const bool interleaved = true;
#else
const bool interleaved = false;
#endif

vec2 at_level(vec2 p)
{
    return (p + 0.5) / level_scale - 0.5;
}

vec2 probed_vector(int field, int i)
{
    return field == FIELD_FORWARD ? forward[i].xy : -backward[i].xy;
}

vec2 candidate_vectors[MAX_CANDIDATES];
int candidate_modes[MAX_CANDIDATES];
float coverage[MAX_CANDIDATES][4];
float fallback_sum[4] = float[4](0.0, 0.0, 0.0, 0.0);
float coverage_sum[4] = float[4](0.0, 0.0, 0.0, 0.0);
float panel_sum[4] = float[4](0.0, 0.0, 0.0, 0.0);
int candidate_count = 0;
bool has_uncover = false;
vec4 light = vec4(0.0);

int candidate_slot(vec2 u, int mode)
{
    int ci = -1;
    for (int i = 0; i < candidate_count; i++) {
        if (candidate_vectors[i] == u) {
            ci = i;
        }
    }
    if (ci >= 0) {
        return ci;
    }
    ci = candidate_count++;
    candidate_vectors[ci] = u;
    candidate_modes[ci] = mode;
    has_uncover = has_uncover || mode == MB_MODE_UNCOVER;
    for (int j = 0; j < 4; j++) {
        coverage[ci][j] = 0.0;
    }
    return ci;
}

void add_coverage(int ci, ivec2 b, int bi, ivec2 q0)
{
    vec2 cb = vec2(b * 8) + 3.5;
    for (int j = 0; j < 4; j++) {
        vec2 p = at_level(vec2(q0 + ivec2(j & 1, j >> 1)));
        vec2 w2 = max(vec2(0.0), 1.0 - abs(p - cb) / 8.0);
        coverage[ci][j] += w2.x * w2.y;
        fallback_sum[j] += w2.x * w2.y * fallback_weights[bi];
        panel_sum[j] += w2.x * w2.y * panel_weights[bi];
        coverage_sum[j] += w2.x * w2.y;
        light += w2.x * w2.y * vec4(offsets[bi].xyz, 1.0);
    }
}

void gather_blocks(ivec2 q0)
{
    ivec2 qm = q0 >> push.base_level;
    int qx = qm.x >> 2, qy = qm.y >> 2;
    int bx = (qx & 1) != 0 ? qx / 2 : qx / 2 - 1;
    int by = (qy & 1) != 0 ? qy / 2 : qy / 2 - 1;
    for (int k = 0; k < 4; k++) {
        ivec2 b = ivec2(bx + (k & 1), by + (k >> 1));
        int bi = block_index(b, blocks());
        ivec2 cell = clamp(b * 2 + clamp((qm - b * 8) >> 2, ivec2(0), ivec2(1)), ivec2(0), blocks() * 2 - 1);
        vec4 tv = cells[cell.y * push.blocks_x * 2 + cell.x];
        int ci = candidate_slot(tv.xy * level_scale, int(tv.z));
        add_coverage(ci, b, bi, q0);
    }
    light /= max(light.w, 1e-6);
}

float t;
int fallback_index;
float cost[MAX_CANDIDATES][4];
uint sides[4] = uint[4](0u, 0u, 0u, 0u);
float weight_a[MAX_CANDIDATES][4], weight_b[MAX_CANDIDATES][4];
float panel[4];
float panel_share = 0.0;
float switch_weight = 0.0;
float global_a_luma[4] = float[4](0.0, 0.0, 0.0, 0.0), global_b_luma[4] = float[4](0.0, 0.0, 0.0, 0.0);
vec2 global_a_chroma = vec2(0.0), global_b_chroma = vec2(0.0);
vec2 global_a, global_b;

void add_fallback()
{
    fallback_index = candidate_count++;
    candidate_vectors[fallback_index] = vec2(0.0);
    candidate_modes[fallback_index] = MB_MODE_TWO_SIDED;
    for (int j = 0; j < 4; j++) {
        coverage[fallback_index][j] = 1.0 - push.candidate_prior;
    }
}

vec2 trust_sides(int i, ivec2 q0)
{
    vec2 u = candidate_vectors[i];
    if (candidate_modes[i] != MB_MODE_TWO_SIDED) {
        return vec2(float(candidate_modes[i] == MB_MODE_PAST),
                    float(candidate_modes[i] == MB_MODE_FUTURE || candidate_modes[i] == MB_MODE_UNCOVER));
    }
    vec2 center = vec2(q0) + 0.5;
    float a = consistent_share(FIELD_FORWARD, center + -t * u, u);
    float b = consistent_share(FIELD_BACKWARD, center + (1.0 - t) * u, u);
    return vec2(a, b);
}

void measure_differences(vec2 u, ivec2 q0, float luma_offset)
{
    vec2 oa = -t * u, ob = (1.0 - t) * u;
    for (int y = 0; y < 4; y++) {
        for (int x = 0; x < 4; x++) {
            vec2 p = vec2(q0 + ivec2(x - 1, y - 1)) + 0.5;
            float a = textureLod(a_level, (p + oa) * texel_size, 0.0).r;
            float b = textureLod(b_level, (p + ob) * texel_size, 0.0).r;
            differences[y * 4 + x] = abs((a - b) * 255.0 - luma_offset);
        }
    }
}

void score_pixel(int i, int j, vec2 trust)
{
    vec2 u = candidate_vectors[i];
    vec2 error = window_error(j & 1, j >> 1);
    float e = error.x;
    float qa = round(trust.x * (1.0 - trust.y) * SIDE_LEVELS), qb = round((1.0 - trust.x) * trust.y * SIDE_LEVELS);
    float pixel_cost = trust.x * trust.y * max(0.0, e - push.foreground_bonus * clamp(l1(u) * 0.5, 0.0, 1.0)) +
                       (qa + qb) / SIDE_LEVELS * push.penalty_one_sided +
                       (1.0 - trust.x) * (1.0 - trust.y) * (e + push.penalty_unconfirmed);
    if (push.nearest_hi > 0.0) {
        float nearest = round(smoothstep(push.nearest_lo, push.nearest_hi, error.y) *
                              smoothstep(0.0, 0.25, trust.x * trust.y) * SIDE_LEVELS);
        float before = qa + qb;
        if (t < MB_NEAREST_SWITCH) {
            qa = max(qa, nearest);
            qb = min(qb, SIDE_LEVELS - qa);
        } else {
            qb = max(qb, nearest);
            qa = min(qa, SIDE_LEVELS - qb);
        }
        pixel_cost += max(0.0, qa + qb - before) / SIDE_LEVELS * push.penalty_one_sided;
    }
    cost[i][j] = pixel_cost;
    sides[j] |= (uint(qa) | (uint(qb) << 3)) << (6 * i);
}

void score_candidates(ivec2 q0, float luma_offset)
{
    for (int i = 0; i < candidate_count; i++) {
        if (i == fallback_index) {
            for (int j = 0; j < 4; j++) {
                cost[i][j] = has_uncover ? push.penalty_fallback_uncover : push.penalty_fallback;
            }
            continue;
        }
        vec2 trust = trust_sides(i, q0);
        measure_differences(candidate_vectors[i], q0, luma_offset);
        for (int j = 0; j < 4; j++) {
            score_pixel(i, j, trust);
        }
    }
}

void weigh_pixel(int j)
{
    float lowest = 1e30;
    for (int i = 0; i < candidate_count; i++) {
        lowest = min(lowest, cost[i][j]);
    }
    float total = 0.0, raw[MAX_CANDIDATES];
    for (int i = 0; i < candidate_count; i++) {
        raw[i] = (push.candidate_prior + coverage[i][j]) * soft_score(cost[i][j], lowest);
        total += raw[i];
    }
    float fallback = coverage_sum[j] > 0.0 ? fallback_sum[j] / coverage_sum[j] : 0.0;
    for (int i = 0; i < candidate_count; i++) {
        float w = (1.0 - fallback) * raw[i] / total + (i == fallback_index ? fallback : 0.0);
        uint code = (sides[j] >> (6 * i)) & 63u;
        float qa = float(code & 7u) / SIDE_LEVELS, qb = float(code >> 3) / SIDE_LEVELS;
        float toward_b = t * (1.0 - qa - qb) + qb;
        weight_a[i][j] = w * (1.0 - toward_b);
        weight_b[i][j] = w * toward_b;
    }
}

bool contributes(int i)
{
    return weight_a[i][0] + weight_b[i][0] + weight_a[i][1] + weight_b[i][1] + weight_a[i][2] + weight_b[i][2] +
               weight_a[i][3] + weight_b[i][3] > 0.0;
}

void blend_luma(ivec2 q0, float dy, out float luma[4])
{
    luma = float[4](0.0, 0.0, 0.0, 0.0);
    for (int i = 0; i < candidate_count; i++) {
        if (!contributes(i)) {
            continue;
        }
        float sa[4], sb[4];
        quad_cubic(a_luma, vec2(q0) + 0.5 - t * candidate_vectors[i], texel_size, sa);
        quad_cubic(b_luma, vec2(q0) + 0.5 + (1.0 - t) * candidate_vectors[i], texel_size, sb);
        for (int j = 0; j < 4; j++) {
            luma[j] += weight_a[i][j] * (sa[j] - t * dy) + weight_b[i][j] * (sb[j] + (1.0 - t) * dy);
        }
    }
}

vec2 sample_a_chroma(vec2 position)
{
    return chroma_sample(a_chroma1, a_chroma2, position * chroma_texel_size(), interleaved);
}

vec2 sample_b_chroma(vec2 position)
{
    return chroma_sample(b_chroma1, b_chroma2, position * chroma_texel_size(), interleaved);
}

void measure_panels(ivec2 q0)
{
    for (int j = 0; j < 4; j++) {
        panel[j] = coverage_sum[j] > 0.0 ? panel_sum[j] / coverage_sum[j] : 0.0;
        panel_share += panel[j] * 0.25;
    }
    vec2 global = global_motion[0].xy * level_scale;
    global_a = -t * global;
    global_b = (1.0 - t) * global;
    if (panel_share <= 0.0) {
        return;
    }
    vec2 qc = (vec2(q0) + 1.0) / chroma_shift();
    global_a_chroma = sample_a_chroma(qc + global_a / chroma_shift());
    global_b_chroma = sample_b_chroma(qc + global_b / chroma_shift());
    vec2 chroma_change = abs(global_a_chroma - global_b_chroma);
    float luma_change = 0.0;
    for (int j = 0; j < 4; j++) {
        vec2 pp = vec2(q0 + ivec2(j & 1, j >> 1)) + 0.5;
        global_a_luma[j] = textureLod(a_luma, (pp + global_a) * texel_size, 0.0).r;
        global_b_luma[j] = textureLod(b_luma, (pp + global_b) * texel_size, 0.0).r;
        luma_change = max(luma_change, abs(global_a_luma[j] - global_b_luma[j]));
    }
    float change = max(max(chroma_change.x, chroma_change.y), luma_change) * 255.0 * push.luma_scale;
    switch_weight = smoothstep(push.panel_switch, push.panel_switch * 2.5, change);
}

float unmoved(float a, float b)
{
    return mix((1.0 - t) * a + t * b, t < MB_NEAREST_SWITCH ? a : b, switch_weight);
}

void store_luma(ivec2 q0, float luma[4])
{
    for (int j = 0; j < 4; j++) {
        ivec2 p = q0 + ivec2(j & 1, j >> 1);
        if (panel[j] > 0.0) {
            luma[j] = mix(luma[j], unmoved(global_a_luma[j], global_b_luma[j]), panel[j]);
        }
        if (p.x < push.width && p.y < push.height) {
            imageStore(out_luma, p, vec4(output_value(luma[j])));
        }
    }
}

vec2 covered_weights(int i, ivec2 index)
{
    CoveredPixels cover = covered_pixels(index);
    float ca = 0.0, cb = 0.0;
    for (int k = 0; k < cover.count; k++) {
        ca += weight_a[i][cover.index[k]];
        cb += weight_b[i][cover.index[k]];
    }
    float norm = 1.0 / float(cover.count);
    return vec2(ca * norm, cb * norm);
}

vec2 warped_chroma(vec2 pc, vec2 offset_a, vec2 offset_b, vec2 weights, vec2 chroma_offset)
{
    vec2 a = cubic_chroma(a_chroma1, a_chroma2, pc - offset_a), b = cubic_chroma(b_chroma1, b_chroma2, pc + offset_b);
    return weights.x * (a - t * chroma_offset) + weights.y * (b + (1.0 - t) * chroma_offset);
}

vec2 blend_chroma(ivec2 index, ivec2 cp)
{
    vec2 pc = vec2(cp) + 0.5;
    vec2 acc = vec2(0.0);
    for (int i = 0; i < candidate_count; i++) {
        vec2 weights = covered_weights(i, index);
        if (weights.x + weights.y <= 0.0) {
            continue;
        }
        acc += warped_chroma(pc, t * candidate_vectors[i] / chroma_shift(),
                             (1.0 - t) * candidate_vectors[i] / chroma_shift(), weights, light.yz);
    }
    if (panel_share > 0.0) {
        vec2 sa = global_a_chroma, sb = global_b_chroma;
        if (push.shift_x != 1 || push.shift_y != 1) {
            sa = sample_a_chroma(pc + global_a / chroma_shift());
            sb = sample_b_chroma(pc + global_b / chroma_shift());
        }
        acc = mix(acc, vec2(unmoved(sa.x, sb.x), unmoved(sa.y, sb.y)), panel_share);
    }
    return acc;
}

void blend_quad_chroma(ivec2 q0)
{
    for (int cy = 0; cy < (2 >> push.shift_y); cy++) {
        for (int cx = 0; cx < (2 >> push.shift_x); cx++) {
            ivec2 cp = (q0 >> ivec2(push.shift_x, push.shift_y)) + ivec2(cx, cy);
            if (cp.x < push.chroma_width && cp.y < push.chroma_height) {
                store_chroma(cp, blend_chroma(ivec2(cx, cy), cp));
            }
        }
    }
}

void main()
{
    level_scale = float(1 << push.base_level);
    ivec2 q0 = ivec2(gl_GlobalInvocationID.xy) * 2;
    if (q0.x >= push.width || q0.y >= push.height || stats[MB_STAT_CUT] != 0u) {
        return;
    }
    texel_size = 1.0 / vec2(push.width, push.height);
    t = push.t;
    gather_blocks(q0);
    add_fallback();
    score_candidates(q0, light.x * 255.0 * push.luma_scale);
    for (int j = 0; j < 4; j++) {
        weigh_pixel(j);
    }
    float luma[4];
    blend_luma(q0, light.x, luma);
    measure_panels(q0);
    store_luma(q0, luma);
    blend_quad_chroma(q0);
}
