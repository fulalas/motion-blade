#version 450
#extension GL_GOOGLE_include_directive : enable
#include "push_constants.h"
layout(push_constant) uniform Push { extrapolate_push push; };
#include "warp.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 6) readonly buffer PastField { vec4 past_field[]; };
layout(std430, binding = 7) readonly buffer PastStats { uint past_stats[]; };
layout(std430, binding = 8) readonly buffer Stats { uint stats[]; };
layout(std430, binding = 14) readonly buffer NextField { vec4 next_field[]; };
layout(std430, binding = 15) readonly buffer NextStats { uint next_stats[]; };
layout(binding = 16) uniform sampler2D past_neighbour_level;
layout(binding = 17) uniform sampler2D next_neighbour_level;

bool from_b;

vec2 probed_vector(int field, int i)
{
    return field == FIELD_PAST ? past_field[i].xy : next_field[i].xy;
}

void copy_frame(ivec2 q0)
{
    for (int j = 0; j < 4; j++) {
        ivec2 p = q0 + ivec2(j & 1, j >> 1);
        if (p.x < push.width && p.y < push.height) {
            imageStore(out_luma, p, vec4(from_b ? texelFetch(b_luma, p, 0).r : texelFetch(a_luma, p, 0).r));
        }
    }
    for (int cy = 0; cy < (2 >> push.shift_y); cy++) {
        for (int cx = 0; cx < (2 >> push.shift_x); cx++) {
            ivec2 cp = (q0 >> ivec2(push.shift_x, push.shift_y)) + ivec2(cx, cy);
            if (cp.x >= push.chroma_width || cp.y >= push.chroma_height) {
                continue;
            }
            imageStore(out_chroma1, cp, from_b ? texelFetch(b_chroma1, cp, 0) : texelFetch(a_chroma1, cp, 0));
#ifndef NV
            imageStore(out_chroma2, cp, from_b ? texelFetch(b_chroma2, cp, 0) : texelFetch(a_chroma2, cp, 0));
#endif
        }
    }
}

float reach;
vec2 extrapolation_vectors[MB_EXTRAPOLATION_VECTORS];
int extrapolation_count = 0;
float extrapolation_weights[MB_EXTRAPOLATION_VECTORS][4];

bool past_usable()
{
    return (push.extrapolate & 1) != 0 && past_stats[MB_STAT_CUT] == 0u;
}

bool next_usable()
{
    return (push.extrapolate & 2) != 0 && next_stats[MB_STAT_CUT] == 0u;
}

vec2 field_at(int i)
{
    return from_b ? next_field[i].xy : past_field[i].xy;
}

vec2 field_vector(vec2 p)
{
    BlockTaps taps = taps_at(p / level_scale, blocks());
    vec2 sum = vec2(0.0);
    for (int k = 0; k < 4; k++) {
        sum += field_at(taps.index[k]) * taps.weight[k];
    }
    return sum * level_scale;
}

void add_extrapolation_vector(vec2 w)
{
    for (int i = 0; i < extrapolation_count; i++) {
        if (l1(extrapolation_vectors[i] - w) < MB_SAME_VECTOR) {
            return;
        }
    }
    extrapolation_vectors[extrapolation_count++] = w;
}

void gather_extrapolation(ivec2 q0)
{
    vec2 center = vec2(q0) + 1.0;
    add_extrapolation_vector(field_vector(center + field_vector(center) * reach));
    ivec2 block = block_at(center / level_scale);
    for (int k = 0; k < 9; k++) {
        add_extrapolation_vector(field_at(neighbour3_index(k, block, blocks())) * level_scale);
    }
}

float source_level(vec2 at)
{
    return from_b ? textureLod(b_level, at * texel_size, 0.0).r : textureLod(a_level, at * texel_size, 0.0).r;
}

float neighbour_level(vec2 at)
{
    return from_b ? textureLod(next_neighbour_level, at * texel_size, 0.0).r
                  : textureLod(past_neighbour_level, at * texel_size, 0.0).r;
}

void score_extrapolation(int i, ivec2 q0)
{
    vec2 w = extrapolation_vectors[i];
    for (int y = 0; y < 4; y++) {
        for (int x = 0; x < 4; x++) {
            vec2 p = vec2(q0 + ivec2(x - 1, y - 1)) + 0.5;
            differences[y * 4 + x] = abs(source_level(p + w * reach) - neighbour_level(p + w * (1.0 + reach))) * 255.0;
        }
    }
    float settled = consistent_share(from_b ? FIELD_NEXT : FIELD_PAST, vec2(q0) + 1.0 + w * reach, w);
    float unsettled = (1.0 - settled) * push.penalty_unconfirmed;
    for (int j = 0; j < 4; j++) {
        extrapolation_weights[i][j] = window_error(j & 1, j >> 1).x + unsettled;
    }
}

void weigh_extrapolation(ivec2 q0)
{
    for (int i = 0; i < extrapolation_count; i++) {
        score_extrapolation(i, q0);
    }
    for (int j = 0; j < 4; j++) {
        float lowest = 1e30;
        for (int i = 0; i < extrapolation_count; i++) {
            lowest = min(lowest, extrapolation_weights[i][j]);
        }
        float total = 0.0;
        for (int i = 0; i < extrapolation_count; i++) {
            extrapolation_weights[i][j] = soft_score(extrapolation_weights[i][j], lowest);
            total += extrapolation_weights[i][j];
        }
        for (int i = 0; i < extrapolation_count; i++) {
            extrapolation_weights[i][j] /= total;
        }
    }
}

bool extrapolation_contributes(int i)
{
    return extrapolation_weights[i][0] + extrapolation_weights[i][1] + extrapolation_weights[i][2] +
               extrapolation_weights[i][3] > 0.0;
}

void extrapolate_luma(ivec2 q0)
{
    float luma[4] = float[4](0.0, 0.0, 0.0, 0.0);
    for (int i = 0; i < extrapolation_count; i++) {
        if (!extrapolation_contributes(i)) {
            continue;
        }
        float s[4];
        vec2 at = vec2(q0) + 0.5 + extrapolation_vectors[i] * reach;
        if (from_b) {
            quad_cubic(b_luma, at, texel_size, s);
        } else {
            quad_cubic(a_luma, at, texel_size, s);
        }
        for (int j = 0; j < 4; j++) {
            luma[j] += extrapolation_weights[i][j] * s[j];
        }
    }
    for (int j = 0; j < 4; j++) {
        ivec2 p = q0 + ivec2(j & 1, j >> 1);
        if (p.x < push.width && p.y < push.height) {
            imageStore(out_luma, p, vec4(output_value(luma[j])));
        }
    }
}

float covered_extrapolation_weight(int i, ivec2 index)
{
    CoveredPixels cover = covered_pixels(index);
    float sum = 0.0;
    for (int k = 0; k < cover.count; k++) {
        sum += extrapolation_weights[i][cover.index[k]];
    }
    return sum / float(cover.count);
}

vec2 extrapolated_chroma(ivec2 index, ivec2 cp)
{
    vec2 acc = vec2(0.0);
    for (int i = 0; i < extrapolation_count; i++) {
        float w = covered_extrapolation_weight(i, index);
        if (w > 0.0) {
            vec2 at = vec2(cp) + 0.5 + extrapolation_vectors[i] * reach / chroma_shift();
            acc += w * (from_b ? cubic_chroma(b_chroma1, b_chroma2, at) : cubic_chroma(a_chroma1, a_chroma2, at));
        }
    }
    return acc;
}

void extrapolate_chroma(ivec2 q0)
{
    for (int cy = 0; cy < (2 >> push.shift_y); cy++) {
        for (int cx = 0; cx < (2 >> push.shift_x); cx++) {
            ivec2 cp = (q0 >> ivec2(push.shift_x, push.shift_y)) + ivec2(cx, cy);
            if (cp.x < push.chroma_width && cp.y < push.chroma_height) {
                store_chroma(cp, extrapolated_chroma(ivec2(cx, cy), cp));
            }
        }
    }
}

void extrapolate_quad(ivec2 q0)
{
    reach = from_b ? 1.0 - push.t : push.t;
    gather_extrapolation(q0);
    weigh_extrapolation(q0);
    extrapolate_luma(q0);
    extrapolate_chroma(q0);
}

void main()
{
    level_scale = float(1 << push.base_level);
    ivec2 q0 = ivec2(gl_GlobalInvocationID.xy) * 2;
    if (q0.x >= push.width || q0.y >= push.height || stats[MB_STAT_CUT] == 0u) {
        return;
    }
    texel_size = 1.0 / vec2(push.width, push.height);
    bool past = past_usable(), next = next_usable(), near_a = push.t < MB_CUT_SIDE_SWITCH;
    if (past || next) {
        from_b = next && !(past && near_a);
        extrapolate_quad(q0);
    } else {
        from_b = !near_a;
        copy_frame(q0);
    }
}
