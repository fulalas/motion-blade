#version 450
#extension GL_GOOGLE_include_directive : enable
#include "push_constants.h"
layout(push_constant) uniform Push { layer_pair_push push; };
#include "layer.glsl"
layout(local_size_x = MB_LAYER_PAIR_LANES) in;

layout(std430, binding = 0) buffer ForwardModel { vec4 forward_model[]; };
layout(std430, binding = 1) buffer BackwardModel { vec4 backward_model[]; };
layout(std430, binding = 2) buffer PastForward { vec4 past_forward[]; };
layout(std430, binding = 3) buffer PastBackward { vec4 past_backward[]; };
layout(std430, binding = 4) buffer ForwardField { vec4 forward_field[]; };
layout(std430, binding = 5) buffer BackwardField { vec4 backward_field[]; };
layout(std430, binding = 6) buffer PastForwardField { vec4 past_forward_field[]; };
layout(std430, binding = 7) buffer PastBackwardField { vec4 past_backward_field[]; };

#define KEEP 0
#define BORROW_FORWARD 1
#define BORROW_BACKWARD 2

shared vec4 models[4];
shared int action;
shared ivec2 shift;
shared vec2 counts[MB_LAYER_PAIR_LANES];
bool visible;

float l1(vec2 v)
{
    return abs(v.x) + abs(v.y);
}

bool directions_agree(vec4 f, vec4 b)
{
    return l1(f.xy + b.xy) <= float(MB_LAYER_PAIR_REL) * max(l1(f.xy), l1(b.xy)) + float(MB_LAYER_PAIR_ABS);
}

bool continues_into(vec4 past, vec4 current)
{
    return current.z > 0.5 && past.w >= push.min_share * float(MB_LAYER_KEEP_SHARE) &&
           l1(past.xy) >= float(MB_LAYER_KEEP_MIN_LENGTH) &&
           l1(past.xy - current.xy) <= float(MB_LAYER_ADOPT_REL) * l1(current.xy) + float(MB_LAYER_ADOPT_ABS);
}

bool measured_layer(vec4 f, vec4 b)
{
    return abs(f.z - 1.0) < 0.125 && abs(b.z - 1.0) < 0.125;
}

bool nearly_measured(vec4 measured, vec4 other)
{
    return abs(measured.z - 1.0) < 0.125 && other.w >= push.min_share * float(MB_LAYER_KEEP_SHARE) &&
           l1(other.xy) >= float(MB_LAYER_KEEP_MIN_LENGTH);
}

bool inside_search(vec4 m)
{
    float margin = float(MB_LAYER_LEND_MARGIN);
    return abs(m.x) <= float(MB_LAYER_RANGE_X) - margin && abs(m.y) <= float(MB_LAYER_RANGE_Y) - margin;
}

bool entering_layer(vec4 f, vec4 b)
{
    return inside_search(f) && inside_search(b) && (nearly_measured(f, b) || nearly_measured(b, f));
}

ivec2 lend_shift()
{
    vec4 f = forward_model[0], b = backward_model[0];
    return ivec2(floor((abs(f.z - 1.0) < 0.125 ? f.xy : -b.xy) / float(MB_LAYER_CELL) + 0.5));
}

void count_visible(int lane, ivec2 cells)
{
    ivec2 s = lend_shift();
    vec2 part = vec2(0.0);
    for (int i = lane; i < cells.x * cells.y; i += MB_LAYER_PAIR_LANES) {
        ivec2 c = ivec2(i % cells.x, i / cells.x) - s;
        bool layer = forward_field[i].z > 0.5;
        part += vec2(layer ? 1.0 : 0.0, layer && all(greaterThanEqual(c, ivec2(0))) && all(lessThan(c, cells)) ? 1.0 : 0.0);
    }
    counts[lane] = part;
    barrier();
    if (lane == 0) {
        vec2 total = vec2(0.0);
        for (int k = 0; k < MB_LAYER_PAIR_LANES; k++) {
            total += counts[k];
        }
        visible = total.x > 0.0 && total.y >= float(MB_LAYER_LEND_VISIBLE) * total.x;
    }
}

bool no_layer(vec4 f, vec4 b)
{
    return f.z <= 0.5 && b.z <= 0.5;
}

void decide()
{
    vec4 f = forward_model[0], b = backward_model[0];
    if (!directions_agree(f, b)) {
        f.z = 0.0;
        b.z = 0.0;
    }
    action = KEEP;
    models[0] = f;
    models[1] = b;
    if (push.has_past == 0) {
        return;
    }
    vec4 pf = past_forward[0], pb = past_backward[0];
    if (directions_agree(pf, pb)) {
        if (pf.z <= 0.5 && continues_into(pf, f)) {
            pf.z = 2.0;
        }
        if (pb.z <= 0.5 && continues_into(pb, b)) {
            pb.z = 2.0;
        }
    }
    if (no_layer(f, b) && measured_layer(pf, pb)) {
        action = BORROW_FORWARD;
        models[0] = vec4(pf.xy, float(MB_LAYER_BORROWED), pf.w);
        models[1] = vec4(pb.xy, float(MB_LAYER_BORROWED), pb.w);
    } else if (no_layer(pf, pb) && entering_layer(f, b) && visible) {
        action = BORROW_BACKWARD;
        shift = lend_shift();
        pf = vec4(f.xy, 2.0, f.w);
        pb = vec4(b.xy, 2.0, b.w);
    }
    models[2] = pf;
    models[3] = pb;
}

void main()
{
    int lane = int(gl_LocalInvocationID.x);
    ivec2 cells = ivec2(push.cells_x, push.cells_y);
    count_visible(lane, cells);
    if (lane == 0) {
        decide();
    }
    barrier();
    for (int i = lane; i < cells.x * cells.y && action != KEEP; i += MB_LAYER_PAIR_LANES) {
        if (action == BORROW_FORWARD) {
            forward_field[i] = past_forward_field[i];
            backward_field[i] = past_backward_field[i];
        } else {
            int source = layer_cell_index(ivec2(i % cells.x, i / cells.x) + shift, cells);
            past_forward_field[i] = forward_field[source];
            past_backward_field[i] = backward_field[source];
        }
    }
    if (lane == 0) {
        forward_model[0] = models[0];
        backward_model[0] = models[1];
        if (push.has_past != 0) {
            past_forward[0] = models[2];
            past_backward[0] = models[3];
        }
    }
}
