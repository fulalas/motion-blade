#version 450
#extension GL_GOOGLE_include_directive : enable
#include "push_constants.h"
layout(push_constant) uniform Push { layer_pair_push push; };
#include "layer.glsl"
layout(local_size_x = MB_LAYER_PAIR_LANES) in;

layout(std430, binding = 0) buffer ForwardModel { vec4 forward_model[]; };
layout(std430, binding = 1) buffer BackwardModel { vec4 backward_model[]; };
layout(std430, binding = 2) buffer PastForward { vec4 past_forward[]; };
layout(std430, binding = 3) buffer PastBackward { vec4 past_backward[]; };
layout(std430, binding = 4) buffer ForwardField { vec4 forward_field[]; };
layout(std430, binding = 5) buffer BackwardField { vec4 backward_field[]; };
layout(std430, binding = 6) buffer PastForwardField { vec4 past_forward_field[]; };
layout(std430, binding = 7) buffer PastBackwardField { vec4 past_backward_field[]; };
layout(std430, binding = 8) readonly buffer ForwardVectors { vec4 forward_vectors[]; };
layout(std430, binding = 9) readonly buffer BackwardVectors { vec4 backward_vectors[]; };

#define KEEP 0
#define BORROW_FORWARD 1
#define BORROW_BACKWARD 2

shared vec4 models[4];
shared int action;
shared ivec2 shift;
shared vec2 counts[MB_LAYER_PAIR_LANES];
shared bool tracked;
bool visible;

bool is_tight(float blocks, float inliers, vec2 sum, float squares)
{
    if (inliers < 0.5 || inliers < float(MB_LAYER_TRACK_INLIERS) * blocks) {
        return false;
    }
    vec2 mean = sum / inliers;
    float spread = float(MB_LAYER_TRACK_SPREAD) * push.vector_scale;
    return squares / inliers - dot(mean, mean) <= spread * spread;
}

#define TRACKED_CELLS(NAME, MODEL, FIELD, VECTORS)                                                  \
    vec2 NAME(int lane, ivec2 cells)                                                                \
    {                                                                                               \
        vec2 part = vec2(0.0);                                                                      \
        if (MODEL[0].z <= 0.5) {                                                                    \
            return part;                                                                            \
        }                                                                                           \
        for (int i = lane; i < cells.x * cells.y; i += MB_LAYER_PAIR_LANES) {                       \
            if (FIELD[i].z <= 0.5) {                                                                \
                continue;                                                                           \
            }                                                                                       \
            vec2 expected = FIELD[i].xy;                                                            \
            float limit = float(MB_LAYER_TRACK_REL) * l1(expected) + float(MB_LAYER_TRACK_ABS);     \
            ivec2 first = ivec2(i % cells.x, i / cells.x) * push.cell_blocks;                       \
            ivec2 last = min(first + push.cell_blocks, ivec2(push.blocks_x, push.blocks_y));        \
            float blocks = 0.0;                                                                     \
            float inliers = 0.0;                                                                    \
            vec2 sum = vec2(0.0);                                                                   \
            float squares = 0.0;                                                                    \
            for (int y = first.y; y < last.y; y++) {                                                \
                for (int x = first.x; x < last.x; x++) {                                            \
                    vec2 apart = VECTORS[y * push.blocks_x + x].xy * push.vector_scale - expected;  \
                    bool inlier = l1(apart) <= limit;                                               \
                    blocks += 1.0;                                                                  \
                    inliers += inlier ? 1.0 : 0.0;                                                  \
                    sum += inlier ? apart : vec2(0.0);                                              \
                    squares += inlier ? dot(apart, apart) : 0.0;                                    \
                }                                                                                   \
            }                                                                                       \
            part += vec2(1.0, is_tight(blocks, inliers, sum, squares) ? 1.0 : 0.0);                 \
        }                                                                                           \
        return part;                                                                                \
    }

TRACKED_CELLS(tracked_forward, forward_model, forward_field, forward_vectors)
TRACKED_CELLS(tracked_backward, backward_model, backward_field, backward_vectors)

void find_tracked(int lane, ivec2 cells)
{
    counts[lane] = tracked_forward(lane, cells) + tracked_backward(lane, cells);
    barrier();
    if (lane == 0) {
        vec2 total = vec2(0.0);
        for (int k = 0; k < MB_LAYER_PAIR_LANES; k++) {
            total += counts[k];
        }
        tracked = total.x > 0.0 && total.y >= float(MB_LAYER_TRACK_SHARE) * total.x;
    }
    barrier();
}

bool directions_agree(vec4 f, vec4 b)
{
    return l1(f.xy + b.xy) <= float(MB_LAYER_PAIR_REL) * max(l1(f.xy), l1(b.xy)) + float(MB_LAYER_PAIR_ABS);
}

bool is_measured(vec4 m)
{
    return abs(m.z - 1.0) < 0.125;
}

bool big_enough_to_keep(vec4 m)
{
    return m.w >= push.min_share * float(MB_LAYER_KEEP_SHARE) && l1(m.xy) >= float(MB_LAYER_KEEP_MIN_LENGTH);
}

bool continues_into(vec4 past, vec4 current)
{
    return current.z > 0.5 && big_enough_to_keep(past) &&
           l1(past.xy - current.xy) <= float(MB_LAYER_ADOPT_REL) * l1(current.xy) + float(MB_LAYER_ADOPT_ABS);
}

bool measured_layer(vec4 f, vec4 b)
{
    return is_measured(f) && is_measured(b);
}

bool nearly_measured(vec4 measured, vec4 other)
{
    return is_measured(measured) && big_enough_to_keep(other);
}

bool entering_layer(vec4 f, vec4 b)
{
    return layer_inside_search(f.xy) && layer_inside_search(b.xy) && (nearly_measured(f, b) || nearly_measured(b, f));
}

ivec2 lend_shift(vec4 f, vec4 b)
{
    return ivec2(floor((is_measured(f) ? f.xy : -b.xy) / float(MB_LAYER_CELL) + 0.5));
}

void count_visible(int lane, ivec2 cells, ivec2 s)
{
    vec2 part = vec2(0.0);
    for (int i = lane; i < cells.x * cells.y; i += MB_LAYER_PAIR_LANES) {
        bool layer = forward_field[i].z > 0.5;
        part += vec2(layer ? 1.0 : 0.0, layer && layer_cell_inside(ivec2(i % cells.x, i / cells.x) - s, cells) ? 1.0 : 0.0);
    }
    counts[lane] = part;
    barrier();
    if (lane == 0) {
        vec2 total = vec2(0.0);
        for (int k = 0; k < MB_LAYER_PAIR_LANES; k++) {
            total += counts[k];
        }
        visible = total.x > 0.0 && total.y >= float(MB_LAYER_LEND_VISIBLE) * total.x;
    }
}

bool no_layer(vec4 f, vec4 b)
{
    return f.z <= 0.5 && b.z <= 0.5;
}

struct Plan {
    vec4 f;
    vec4 b;
    vec4 pf;
    vec4 pb;
};

Plan plan()
{
    Plan p = Plan(forward_model[0], backward_model[0], vec4(0.0), vec4(0.0));
    if (tracked || !directions_agree(p.f, p.b)) {
        p.f.z = 0.0;
        p.b.z = 0.0;
    }
    if (push.has_past == 0) {
        return p;
    }
    p.pf = past_forward[0];
    p.pb = past_backward[0];
    if (directions_agree(p.pf, p.pb)) {
        if (p.pf.z <= 0.5 && continues_into(p.pf, p.f)) {
            p.pf.z = float(MB_LAYER_ADOPTED_STATE);
        }
        if (p.pb.z <= 0.5 && continues_into(p.pb, p.b)) {
            p.pb.z = float(MB_LAYER_ADOPTED_STATE);
        }
    }
    return p;
}

bool borrows_forward(Plan p)
{
    return push.has_past != 0 && !tracked && no_layer(p.f, p.b) && measured_layer(p.pf, p.pb);
}

bool may_lend_back(Plan p)
{
    return push.has_past != 0 && !borrows_forward(p) && no_layer(p.pf, p.pb) && entering_layer(p.f, p.b);
}

void decide(Plan p)
{
    action = KEEP;
    models[0] = p.f;
    models[1] = p.b;
    if (borrows_forward(p)) {
        action = BORROW_FORWARD;
        models[0] = vec4(p.pf.xy, float(MB_LAYER_BORROWED), p.pf.w);
        models[1] = vec4(p.pb.xy, float(MB_LAYER_BORROWED), p.pb.w);
    } else if (may_lend_back(p) && visible) {
        action = BORROW_BACKWARD;
        shift = lend_shift(p.f, p.b);
        p.pf = vec4(p.f.xy, float(MB_LAYER_ADOPTED_STATE), p.f.w);
        p.pb = vec4(p.b.xy, float(MB_LAYER_ADOPTED_STATE), p.b.w);
    }
    models[2] = p.pf;
    models[3] = p.pb;
}

void main()
{
    int lane = int(gl_LocalInvocationID.x);
    ivec2 cells = ivec2(push.cells_x, push.cells_y);
    find_tracked(lane, cells);
    Plan p = plan();
    visible = false;
    if (may_lend_back(p)) {
        count_visible(lane, cells, lend_shift(p.f, p.b));
    }
    if (lane == 0) {
        decide(p);
    }
    barrier();
    for (int i = lane; i < cells.x * cells.y && action != KEEP; i += MB_LAYER_PAIR_LANES) {
        if (action == BORROW_FORWARD) {
            forward_field[i] = past_forward_field[i];
            backward_field[i] = past_backward_field[i];
        } else {
            int source = layer_cell_index(ivec2(i % cells.x, i / cells.x) + shift, cells);
            past_forward_field[i] = forward_field[source];
            past_backward_field[i] = backward_field[source];
        }
    }
    if (lane == 0) {
        forward_model[0] = models[0];
        backward_model[0] = models[1];
        if (push.has_past != 0) {
            past_forward[0] = models[2];
            past_backward[0] = models[3];
        }
    }
}
