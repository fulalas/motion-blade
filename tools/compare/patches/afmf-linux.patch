+static bool paint_source(struct ctx *ctx, uint32_t frame)
+{
+    const char *path = getenv("AFMF_TEST_SOURCE");
+    if (path == NULL)
+        return false;
+    static FILE *src;
+    static long count;
+    size_t size = (size_t)ctx->extent.width * ctx->extent.height * 4u;
+    if (src == NULL) {
+        src = fopen(path, "rb");
+        if (src == NULL || fseek(src, 0, SEEK_END) != 0 || (count = ftell(src) / (long)size) < 1) {
+            (void)fprintf(stderr, "AFMF_TEST_SOURCE %s: no frame to read\n", path);
+            exit(1);
+        }
+    }
+    if (fseek(src, (long)(frame % (uint32_t)count) * (long)size, SEEK_SET) != 0 ||
+        fread(ctx->staging_mapped, 1, size, src) != size) {
+        (void)fprintf(stderr, "AFMF_TEST_SOURCE %s: read failed\n", path);
+        exit(1);
+    }
+    return true;
+}
