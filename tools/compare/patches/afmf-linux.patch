diff --git a/tests/headless_instance.c b/tests/headless_instance.c
index ece0b15..b9d64ca 100644
--- a/tests/headless_instance.c
+++ b/tests/headless_instance.c
@@ -3,6 +3,85 @@
 
 #include "headless.h"
 
+#ifdef AFMF_TEST_WAYLAND
+#include <wayland-client.h>
+#include <vulkan/vulkan_wayland.h>
+#endif
+
+const char *surface_extension_name(void)
+{
+    return wanted_wayland() ? "VK_KHR_wayland_surface" : VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME;
+}
+
+#ifdef AFMF_TEST_WAYLAND
+static void on_global(void *data, struct wl_registry *registry, uint32_t name, const char *interface,
+                      uint32_t version)
+{
+    struct ctx *ctx = data;
+    (void)version;
+    if (strcmp(interface, wl_compositor_interface.name) == 0 && ctx->wl_compositor == NULL)
+        ctx->wl_compositor = wl_registry_bind(registry, name, &wl_compositor_interface, 1);
+}
+
+static void on_global_remove(void *data, struct wl_registry *registry, uint32_t name)
+{
+    (void)data, (void)registry, (void)name;
+}
+
+static const struct wl_registry_listener registry_listener = {on_global, on_global_remove};
+
+/* A wl_surface with no role: the driver attaches and commits to it, the compositor never shows
+ * it, so the run stays as invisible as on the headless surface. */
+static bool create_wayland_surface(struct ctx *ctx)
+{
+    struct wl_display *display = wl_display_connect(NULL);
+    if (display == NULL) {
+        (void)fprintf(stderr, "AFMF_TEST_WSI=wayland: cannot connect to a Wayland compositor\n");
+        return false;
+    }
+    ctx->wl_display = display;
+    struct wl_registry *registry = wl_display_get_registry(display);
+    (void)wl_registry_add_listener(registry, &registry_listener, ctx);
+    (void)wl_display_roundtrip(display);
+    wl_registry_destroy(registry);
+    if (ctx->wl_compositor == NULL) {
+        (void)fprintf(stderr, "AFMF_TEST_WSI=wayland: no wl_compositor\n");
+        return false;
+    }
+    ctx->wl_surface = wl_compositor_create_surface(ctx->wl_compositor);
+    VkWaylandSurfaceCreateInfoKHR info = {
+        .sType = VK_STRUCTURE_TYPE_WAYLAND_SURFACE_CREATE_INFO_KHR,
+        .display = display,
+        .surface = ctx->wl_surface,
+    };
+    CHECK(vkCreateWaylandSurfaceKHR(ctx->instance, &info, NULL, &ctx->surface));
+    return true;
+}
+
+void destroy_window(struct ctx *ctx)
+{
+    if (ctx->wl_surface != NULL)
+        wl_surface_destroy(ctx->wl_surface);
+    if (ctx->wl_compositor != NULL)
+        wl_compositor_destroy(ctx->wl_compositor);
+    if (ctx->wl_display != NULL)
+        wl_display_disconnect(ctx->wl_display);
+    ctx->wl_surface = ctx->wl_compositor = ctx->wl_display = NULL;
+}
+#else
+static bool create_wayland_surface(struct ctx *ctx)
+{
+    (void)ctx;
+    (void)fprintf(stderr, "AFMF_TEST_WSI=wayland: built without wayland-client\n");
+    return false;
+}
+
+void destroy_window(struct ctx *ctx)
+{
+    (void)ctx;
+}
+#endif
