core_inc = include_directories('include', 'src')

core_sources = files(
  'src/common/backend.c',
  'src/common/half.c',
  'src/common/host_image.c',
  'src/common/log.c',
  'src/common/params.c',
  'src/common/resources.c',
  'src/common/status.c',
  'src/common/texture.c',
  'src/common/video.c',
  'src/compensation/chroma.c',
  'src/compensation/cubic.c',
  'src/compensation/extrapolate.c',
  'src/compensation/interpolate.c',
  'src/compensation/offsets.c',
  'src/compensation/panels.c',
  'src/compensation/quad.c',
  'src/engine/crop.c',
  'src/engine/engine.c',
  'src/engine/framing.c',
  'src/engine/geometry.c',
  'src/engine/interpolation.c',
  'src/engine/motion.c',
  'src/engine/outputs.c',
  'src/engine/resources.c',
  'src/estimation/cross_check.c',
  'src/estimation/full_search.c',
  'src/estimation/iterate.c',
  'src/estimation/local_search.c',
  'src/estimation/measure.c',
  'src/estimation/project.c',
  'src/estimation/pyramid.c',
  'src/estimation/search_state.c',
  'src/estimation/window.c',
  'src/framing/bar_tracker.c',
  'src/framing/bars.c',
  'src/framing/border.c',
  'src/reference/cpu_backend.c',
  'src/reference/cpu_transfers.c',
  'src/retiming/pulldown.c',
  'src/retiming/schedule.c',
  'src/scene/cut.c',
  'src/selection/fallback.c',
  'src/selection/median.c',
  'src/selection/select.c',
  'src/selection/select_context.c',
  'src/selection/select_stages.c',
  'src/selection/split.c',
)

mbcore = static_library('mbcore', core_sources,
  include_directories: core_inc,
  dependencies: libm,
  c_args: cc.get_supported_arguments(['-ffp-contract=off']))

core_dep = declare_dependency(link_with: mbcore, include_directories: include_directories('include'),
  dependencies: libm)
core_private_dep = declare_dependency(link_with: mbcore, include_directories: core_inc, dependencies: libm)
