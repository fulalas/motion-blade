#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "sad.glsl"
layout(local_size_x = 64) in;
layout(binding = 0) uniform sampler2D X;
layout(binding = 1) uniform sampler2D Y;
layout(std430, binding = 2) readonly buffer Prev { vec4 prv[]; };
layout(std430, binding = 3) writeonly buffer Out { vec4 o[]; };
layout(std430, binding = 4) readonly buffer Parent { vec4 par[]; };
layout(std430, binding = 5) readonly buffer Temporal { vec4 tmp[]; };
layout(std430, binding = 6) readonly buffer Cross { vec4 crs[]; };
layout(std430, binding = 7) readonly buffer Hist { float hist[]; };

int bw, bh;

vec2 parent_at(int bx, int by)
{
    return par[bidx(ivec2(bx, by), pc.i1.xy)].xy * 2.0;
}

vec2 prev_at(int bx, int by)
{
    bx = clamp(bx, 0, bw - 1);
    by = clamp(by, 0, bh - 1);
    if ((pc.i1.z & 1) != 0)
        return prv[by * bw + bx].xy;
    return parent_at(bx >> 1, by >> 1);
}

uint hash(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

vec2 cl[20];
float pen[20];
int n;

void add(vec2 v, float p)
{
    for (int k = 0; k < n; k++)
        if (cl[k] == v)
            return;
    cl[n] = v;
    pen[n] = p;
    n++;
}

void main()
{
    bw = pc.i0.x;
    bh = pc.i0.y;
    int lane = int(gl_LocalInvocationID.x) & 15;
    int id = int(gl_WorkGroupID.x) * 4 + (int(gl_LocalInvocationID.x) >> 4);
    if (id >= bw * bh)
        return;
    int bx = id % bw, by = id / bw;
    g_inv = 1.0 / vec2(pc.i0.zw);
    load_x(X, bx * 8 - 4, by * 8 - 4, lane);
    int flags = pc.i1.z;
    float mc = 0.0;
    if ((flags & 1) != 0)
        mc = lane < 9 ? abs(prv[nbr3(lane, ivec2(bx, by), ivec2(bw, bh))].w) : 1e30;
    else if ((flags & 2) != 0)
        mc = lane < 9 ? abs(par[nbr3(lane, ivec2(bx, by) >> 1, pc.i1.xy)].w) : 1e30;
    set_dc_w(mc);
    n = 0;
    add(prev_at(bx, by), 0.0);
    add(prev_at(bx - 1, by), 0.0);
    add(prev_at(bx + 1, by), 0.0);
    add(prev_at(bx, by - 1), 0.0);
    add(prev_at(bx, by + 1), 0.0);
    add(prev_at(bx - 1, by - 1), 0.0);
    add(prev_at(bx + 1, by - 1), 0.0);
    add(prev_at(bx - 1, by + 1), 0.0);
    add(prev_at(bx + 1, by + 1), 0.0);
    if ((flags & 2) != 0 && (flags & 1) == 0) {
        int px = bx >> 1, py = by >> 1;
        int qx = (bx & 1) != 0 ? px + 1 : px - 1, qy = (by & 1) != 0 ? py + 1 : py - 1;
        add(parent_at(qx, py), pc.f0.x);
        add(parent_at(px, qy), pc.f0.x);
        add(parent_at(qx, qy), pc.f0.x);
    }
    if ((flags & 4) != 0 && hist[22] == 0.0)
        add(tmp[id].xy, pc.f0.y);
    if ((flags & 8) != 0)
        add(-crs[id].xy, pc.f1.x);
    add(vec2(0.0), pc.f0.w);
    float best_c = 1e30, best_s = 0.0, best_m = 0.0;
    vec2 best_v = vec2(0.0);
    float skip = -1.0;
    if (pc.f1.z > 0.0) {
        float mx = block_sum() / 256.0, ax = 0.0;
        for (int x = 0; x < 16; x++)
            ax += abs(xr[x] - mx);
        skip = max(subgroupClusteredAdd(ax, 16) * 255.0 * pc.f1.z, 32.0);
    }
    for (int i = 0; i < n; i++) {
        float s = sad_y(Y, cl[i]);
        float c = s + pen[i] + pc.f1.y * l1(cl[i]);
        if (c < best_c) {
            best_c = c;
            best_s = s;
            best_m = g_ml;
            best_v = cl[i];
        }
        if (best_s < skip)
            break;
    }
    uint h = hash(uint(id) * 7919u + uint(pc.i1.w) * 104729u);
    vec2 d1 = vec2(float(int(h & 7u)) - 3.5, float(int((h >> 3) & 7u)) - 3.5) * 0.25;
    vec2 d2 = vec2(float(int((h >> 6) & 3u)) - 1.5, float(int((h >> 8) & 3u)) - 1.5);
    vec2 base = best_v;
    for (int k = 0; k < 2 && best_s >= skip; k++) {
        vec2 v = base + (k == 0 ? d1 : d2);
        float s = sad_y(Y, v);
        float c = s + pc.f0.z + pc.f1.y * l1(v);
        if (c < best_c) {
            best_c = c;
            best_s = s;
            best_m = g_ml;
            best_v = v;
        }
    }
    float dcm = block_dc(best_m);
    if (lane == 0)
        o[id] = vec4(best_v, best_s, dcm);
}
