#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 64) in;
layout(binding = 0) uniform sampler2D AY;
layout(binding = 1) uniform sampler2D BY;
layout(binding = 2) uniform sampler2D AC1;
layout(binding = 3) uniform sampler2D BC1;
layout(binding = 4) uniform sampler2D AC2;
layout(binding = 5) uniform sampler2D BC2;
layout(std430, binding = 6) writeonly buffer NW { vec2 nw[]; };
layout(std430, binding = 7) readonly buffer G { vec4 gm[]; };

vec2 chroma(sampler2D T1, sampler2D T2, vec2 p)
{
    return pc.i2.x != 0 ? textureLod(T1, p, 0.0).rg : vec2(textureLod(T1, p, 0.0).r, textureLod(T2, p, 0.0).r);
}

void main()
{
    int bw = pc.i0.x, bh = pc.i0.y;
    int id = int(gl_GlobalInvocationID.x);
    if (id >= bw * bh)
        return;
    if (pc.f0.w <= 0.0) {
        nw[id] = vec2(0.0);
        return;
    }
    float t = pc.f0.x, sc = pc.f0.y;
    vec2 u = gm[0].xy, inv = 1.0 / vec2(pc.i0.zw), cinv = 1.0 / vec2(pc.i1.xy), cs = vec2(1 << pc.i1.z, 1 << pc.i1.w);
    vec2 b0 = vec2(id % bw, id / bw) * 8.0;
    float dc = 0.0, sa = 0.0, sb = 0.0;
    vec2 lo = vec2(1e30), hi = vec2(-1e30);
    for (int k = 0; k < 9; k++) {
        vec2 p = b0 + vec2(k % 3, k / 3) * 3.0 + 1.0;
        vec2 pa = p - t * u, pb = p + (1.0 - t) * u;
        vec2 ca = chroma(AC1, AC2, pa / cs * cinv), cb = chroma(BC1, BC2, pb / cs * cinv);
        vec2 d = abs(ca - cb);
        dc += max(d.x, d.y);
        vec2 qa = abs(ca - pc.f1.z), qb = abs(cb - pc.f1.z);
        sa += max(qa.x, qa.y);
        sb += max(qb.x, qb.y);
        float a = textureLod(AY, pa * inv, 0.0).r, b = textureLod(BY, pb * inv, 0.0).r;
        lo = min(lo, vec2(a, b));
        hi = max(hi, vec2(a, b));
    }
    float d = dc / 9.0 * sc;
    float fl = smoothstep(pc.f1.x, pc.f1.x * 0.5, max(hi.x - lo.x, hi.y - lo.y) * sc);
    float st = smoothstep(pc.f1.w * 0.5, pc.f1.w, min(sa, sb) / 9.0 * sc);
    nw[id] = vec2(smoothstep(pc.f0.z, pc.f0.w, d) * fl * st, fl);
}
