#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "sad.glsl"
layout(local_size_x = 64) in;
layout(binding = 0) uniform sampler2D X;
layout(binding = 1) uniform sampler2D Y;
layout(std430, binding = 2) readonly buffer F { vec4 f[]; };
layout(std430, binding = 3) writeonly buffer Out { vec4 o[]; };
layout(std430, binding = 4) readonly buffer Other { vec4 g[]; };
layout(std430, binding = 5) readonly buffer Keys { uint keys[]; };

shared uint cnt;
shared int lid[64];
shared int lnc[64];
shared vec2 lc[64][4];

void main()
{
    int bw = pc.i0.x, bh = pc.i0.y, nb = bw * bh;
    int t = int(gl_LocalInvocationID.x);
    if (t == 0)
        cnt = 0u;
    barrier();
    int id = int(gl_WorkGroupID.x) * 64 + t;
    if (id < nb) {
        vec4 cur = f[id];
        vec2 w = vec2((id % bw) * 8 - 4, (id / bw) * 8 - 4);
        vec2 cand[4];
        int nc = 0;
        for (int k = 0; k < 4; k++) {
            uint key = keys[id * 4 + k];
            if (key == 0xffffffffu)
                break;
            vec2 u = -g[key >> 1].xy;
            if (l1(u - cur.xy) >= pc.f2.z && all(greaterThanEqual(w + u, vec2(0.0))) &&
                all(lessThanEqual(w + u + 16.0, vec2(pc.i0.zw))))
                cand[nc++] = u;
        }
        if (nc == 0) {
            o[id] = cur;
        } else {
            uint s = atomicAdd(cnt, 1u);
            lid[s] = id;
            lnc[s] = nc;
            for (int k = 0; k < 4; k++)
                lc[s][k] = cand[k];
        }
    }
    barrier();
    int lane = t & 15, grp = t >> 4, n = int(cnt);
    g_inv = 1.0 / vec2(pc.i0.zw);
    for (int j = grp; j < n; j += 4) {
        int bid = lid[j], nc = lnc[j];
        int bx = bid % bw, by = bid / bw;
        vec4 cur = f[bid];
        load_x(X, bx * 8 - 4, by * 8 - 4, lane);
        float s0 = sad_y(Y, cur.xy), best_s = s0, best_m = 0.0;
        float best_c = s0 + pc.f1.y * l1(cur.xy);
        vec2 best_v = cur.xy;
        bool moved = false;
        for (int k = 0; k < nc; k++) {
            vec2 u = lc[j][k];
            float s = sad_y(Y, u);
            float c = s + pc.f1.x + pc.f1.y * l1(u);
            if (c < best_c && s < pc.f2.x * s0 && s0 - s > pc.f2.y) {
                best_c = c;
                best_s = s;
                best_m = g_ml;
                best_v = u;
                moved = true;
            }
        }
        float dcm = block_dc(best_m);
        if (lane == 0)
            o[bid] = moved ? vec4(best_v, best_s, dcm) : cur;
    }
}
