#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_KHR_shader_subgroup_clustered : enable
#include "common.glsl"
layout(local_size_x = 64) in;
layout(binding = 0) uniform sampler2D A;
layout(binding = 1) uniform sampler2D B;
layout(std430, binding = 2) readonly buffer TF { vec4 tf[]; };
layout(std430, binding = 3) writeonly buffer TF4 { vec4 t4[]; };
layout(std430, binding = 4) readonly buffer ILL { vec4 ill[]; };

shared int lst[64];
shared int lcn[64];
shared vec2 lcv[64][9];
shared uint cnt;

int bw, bh;
vec2 cand[9];
int n;

bool gather_cands(ivec2 b, vec2 own)
{
    n = 0;
    bool edge = false;
    for (int k = 0; k < 9; k++) {
        vec4 q = tf[nbr3(k, b, ivec2(bw, bh))];
        if (int(q.z) != 0)
            continue;
        edge = edge || l1(q.xy - own) > pc.f0.y;
        bool dup = false;
        for (int i = 0; i < n; i++)
            dup = dup || cand[i] == q.xy;
        if (!dup)
            cand[n++] = q.xy;
    }
    return edge;
}

float cost(vec2 p, vec2 u, float dc)
{
    float t = pc.f0.x;
    vec2 inv = 1.0 / vec2(pc.i0.zw);
    float d = abs(textureLod(A, (p - t * u) * inv, 0.0).r - textureLod(B, (p + (1.0 - t) * u) * inv, 0.0).r - dc);
    return subgroupClusteredAdd(d, 16) * 255.0;
}

void main()
{
    bw = pc.i0.x;
    bh = pc.i0.y;
    int cw = bw * 2;
    uint t = gl_LocalInvocationID.x;
    if (t == 0u)
        cnt = 0u;
    barrier();
    int id = int(gl_WorkGroupID.x) * 64 + int(t);
    if (id < cw * bh * 2) {
        ivec2 cell = ivec2(id % cw, id / cw), b = cell >> 1;
        vec4 own = tf[bidx(b, ivec2(bw, bh))];
        if (int(own.z) == 0 && pc.f0.y > 0.0 && gather_cands(b, own.xy)) {
            uint s = atomicAdd(cnt, 1u);
            lst[s] = id;
            lcn[s] = n;
            for (int i = 0; i < n; i++)
                lcv[s][i] = cand[i];
        } else {
            t4[id] = own;
        }
    }
    barrier();
    int lane = int(t) & 15, grp = int(t) >> 4, ne = int(cnt);
    for (int j = grp; j < ne; j += 4) {
        int cid = lst[j];
        ivec2 cell = ivec2(cid % cw, cid / cw), b = cell >> 1;
        int bi = bidx(b, ivec2(bw, bh));
        vec4 own = tf[bi];
        float dc = ill[bi].x * pc.f0.w;
        n = lcn[j];
        for (int i = 0; i < n; i++)
            cand[i] = lcv[j][i];
        vec2 p = vec2(cell * 4 + ivec2(lane & 3, lane >> 2)) + 0.5;
        float best = 1e30;
        vec2 bv = own.xy;
        for (int i = 0; i < n; i++) {
            vec2 u = cand[i];
            float s = cost(p, u, dc) + (u == own.xy ? 0.0 : pc.f0.z);
            if (s < best) {
                best = s;
                bv = u;
            }
        }
        for (int r = pc.i1.x; r > 0; r--) {
            vec2 c0 = bv;
            for (int k = 0; k < 8; k++) {
                vec2 u = c0 + vec2(DIR8[k]) * float(r);
                float s = cost(p, u, dc) + pc.f1.x * l1(u - c0);
                if (s < best) {
                    best = s;
                    bv = u;
                }
            }
        }
        if (lane == 0)
            t4[cid] = vec4(bv, 0.0, own.w);
    }
}
