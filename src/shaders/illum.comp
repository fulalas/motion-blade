#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 64) in;
layout(binding = 0) uniform sampler2D AC1;
layout(binding = 1) uniform sampler2D BC1;
layout(binding = 2) uniform sampler2D AC2;
layout(binding = 3) uniform sampler2D BC2;
layout(std430, binding = 4) readonly buffer TF { vec4 tf[]; };
layout(std430, binding = 5) writeonly buffer O { vec4 o[]; };

void main()
{
    int bw = pc.i0.z, bh = pc.i0.w;
    int id = int(gl_GlobalInvocationID.x);
    if (id >= bw * bh)
        return;
    vec2 b0 = vec2(id % bw, id / bw) * 8.0;
    float t = pc.f0.x;
    vec2 u = tf[id].xy, oa = -t * u, ob = (1.0 - t) * u;
    ivec2 sh = pc.i1.zw;
    vec2 cs = vec2(1 << sh.x, 1 << sh.y), cinv = 1.0 / vec2(pc.i1.xy);
    vec2 c0 = b0 / cs, coa = oa / cs, cob = ob / cs;
    vec2 dc = vec2(0.0);
    int nx = 4 >> sh.x, ny = 4 >> sh.y;
    for (int y = 0; y < ny; y++)
        for (int x = 0; x < nx; x++) {
            vec2 p = c0 + vec2(2 * x + 1, 2 * y + 1);
            vec2 ca = (p + coa) * cinv, cb = (p + cob) * cinv;
            if (pc.i2.x != 0)
                dc += textureLod(AC1, ca, 0.0).rg - textureLod(BC1, cb, 0.0).rg;
            else
                dc += vec2(textureLod(AC1, ca, 0.0).r - textureLod(BC1, cb, 0.0).r,
                           textureLod(AC2, ca, 0.0).r - textureLod(BC2, cb, 0.0).r);
        }
    o[id] = vec4(tf[id].w / (255.0 * pc.f0.y), dc / float(nx * ny), 0.0);
}
