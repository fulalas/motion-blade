#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer F { vec4 f[]; };
layout(std430, binding = 1) buffer Keys { uint keys[]; };

void main()
{
    int bw = pc.i0.x, bh = pc.i0.y;
    int id = int(gl_GlobalInvocationID.x);
    if (id >= bw * bh)
        return;
    vec2 v = f[id].xy;
    vec2 c = vec2((id % bw) * 8 + 4, (id / bw) * 8 + 4) + pc.f0.x * v;
    ivec2 q = ivec2(floor(c / 8.0));
    if (any(lessThan(q, ivec2(0))) || q.x >= bw || q.y >= bh)
        return;
    int qi = q.y * bw + q.x;
    uint key = uint(id) * 2u + uint(pc.i1.x != 0);
    for (int k = 0; k < 4 && key != 0xffffffffu; k++)
        key = max(key, atomicMin(keys[qi * 4 + k], key));
}
