#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer Stat { uint stat[]; };
layout(std430, binding = 1) buffer Hist { float h[]; };

#define HN 9

float median(int base, int n)
{
    float v[HN];
    for (int i = 0; i < n; i++)
        v[i] = h[base + i];
    for (int i = 1; i < n; i++)
        for (int j = i; j > 0 && v[j - 1] > v[j]; j--) {
            float x = v[j];
            v[j] = v[j - 1];
            v[j - 1] = x;
        }
    return v[n / 2];
}

void push(int c, int base, float x)
{
    int n = int(h[c]), p = int(h[c + 1]);
    h[base + p] = x;
    h[c + 1] = float((p + 1) % HN);
    h[c] = float(min(n + 1, HN));
}

float spread(int i)
{
    float nb = float(pc.i0.x), m = float(stat[i]) / nb;
    return sqrt(max(float(stat[i + 1]) * 16.0 / nb - m * m, 0.0));
}

void main()
{
    float e = float(stat[0]) * pc.f0.x, z = float(stat[1]) * pc.f0.x;
    float sd = max(spread(3), spread(5));
    float k = pc.f1.y > 0.0 ? clamp(sd / pc.f1.y, pc.f1.z, 1.0) : 1.0;
    int ne = int(h[0]), nz = int(h[2]);
    float te = ne > 0 ? min(pc.f0.y * k, max(10.0 * k, pc.f0.z * median(4, ne) + 4.0 * k)) : pc.f0.y * k;
    float tz = nz > 0 ? max(pc.f0.w * median(4 + HN, nz), pc.f1.x * k) : 0.0;
    bool ecut = e > te, cut = ecut && z > tz;
    if (e > 0.1 && !ecut)
        push(0, 4, e);
    if (e > 0.1 && !cut)
        push(2, 4 + HN, z);
    stat[2] = cut ? 1u : 0u;
    h[22] = cut ? 1.0 : 0.0;
}
