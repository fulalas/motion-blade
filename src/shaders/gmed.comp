#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer TF { vec4 tf[]; };
layout(std430, binding = 1) writeonly buffer G { vec4 g[]; };

shared float sx[256], sy[256];

void main()
{
    int bw = pc.i0.x, bh = pc.i0.y;
    uint t = gl_LocalInvocationID.x;
    ivec2 b = ivec2((int(t & 15u) * 2 + 1) * bw / 32, (int(t >> 4) * 2 + 1) * bh / 32);
    vec2 v = tf[b.y * bw + b.x].xy;
    sx[t] = v.x;
    sy[t] = v.y;
    barrier();
    for (uint k = 2u; k <= 256u; k <<= 1)
        for (uint j = k >> 1; j > 0u; j >>= 1) {
            uint i = t ^ j;
            if (i > t) {
                bool up = (t & k) == 0u;
                if ((sx[t] > sx[i]) == up) {
                    float a = sx[t];
                    sx[t] = sx[i];
                    sx[i] = a;
                }
                if ((sy[t] > sy[i]) == up) {
                    float a = sy[t];
                    sy[t] = sy[i];
                    sy[i] = a;
                }
            }
            barrier();
        }
    if (t == 0u)
        g[0] = vec4(0.5 * (sx[127] + sx[128]), 0.5 * (sy[127] + sy[128]), 0.0, 0.0);
}
