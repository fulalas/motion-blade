#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer TF { vec4 tf[]; };
layout(std430, binding = 1) writeonly buffer FB { float fb[]; };
layout(std430, binding = 2) readonly buffer FA_ { vec4 fa[]; };
layout(std430, binding = 3) readonly buffer FB_ { vec4 fbk[]; };

int bw, bh;

vec2 fat(int which, vec2 p)
{
    int i = bidx(ivec2(floor(p / 8.0)), ivec2(bw, bh));
    return which == 0 ? fa[i].xy : fbk[i].xy;
}

float raw(int bx, int by)
{
    bx = clamp(bx, 0, bw - 1);
    by = clamp(by, 0, bh - 1);
    vec2 u = tf[by * bw + bx].xy;
    if (tf[by * bw + bx].z != 0.0)
        return 0.0;
    float t = pc.f1.x;
    vec2 c = vec2(bx * 8 + 4, by * 8 + 4);
    float ia = l1(fat(0, c - t * u) - u);
    float ib = l1(fat(1, c + (1.0 - t) * u) + u);
    float inc = min(ia, ib) / (1.0 + 0.1 * l1(u));
    return smoothstep(pc.f1.y, pc.f1.z, inc);
}

void main()
{
    bw = pc.i0.x;
    bh = pc.i0.y;
    int id = int(gl_GlobalInvocationID.x);
    if (id >= bw * bh)
        return;
    int bx = id % bw, by = id / bw;
    if (int(tf[id].z) == M_UNC) {
        fb[id] = 0.0;
        return;
    }
    float r[7][7];
    for (int y = 0; y < 7; y++)
        for (int x = 0; x < 7; x++)
            r[y][x] = raw(bx + x - 3, by + y - 3);
    float m = 0.0;
    for (int dy = -2; dy <= 2; dy++)
        for (int dx = -2; dx <= 2; dx++) {
            float s = 0.0;
            for (int k = 0; k < 9; k++) {
                ivec2 o = off3(k);
                s += r[dy + 3 + o.y][dx + 3 + o.x];
            }
            float v = mix(r[dy + 3][dx + 3], s / 9.0, pc.f0.w);
            int d = max(abs(dx), abs(dy));
            m = max(m, v * (d == 0 ? 1.0 : d == 1 ? pc.f0.z : pc.f0.z * pc.f0.z));
        }
    fb[id] = m;
}
