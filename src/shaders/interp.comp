#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D AY;
layout(binding = 1) uniform sampler2D BY;
layout(binding = 2) uniform sampler2D AC1;
layout(binding = 3) uniform sampler2D BC1;
layout(binding = 4) uniform sampler2D AC2;
layout(binding = 5) uniform sampler2D BC2;
layout(std430, binding = 6) readonly buffer TF { vec4 tf[]; };
layout(std430, binding = 7) readonly buffer FA { vec4 fa[]; };
layout(std430, binding = 8) readonly buffer FB { vec4 fb[]; };
layout(binding = 12) uniform sampler2D AL;
layout(binding = 13) uniform sampler2D BL;
layout(std430, binding = 14) readonly buffer Stat { uint stat[]; };
layout(std430, binding = 15) readonly buffer FBW { float fbw[]; };
layout(std430, binding = 16) readonly buffer ILL { vec4 ill[]; };
#ifdef DEPTH16
layout(binding = 9, r16) uniform writeonly image2D oY;
#ifdef NV
layout(binding = 10, rg16) uniform writeonly image2D oC1;
#else
layout(binding = 10, r16) uniform writeonly image2D oC1;
layout(binding = 11, r16) uniform writeonly image2D oC2;
#endif
#else
layout(binding = 9, r8) uniform writeonly image2D oY;
#ifdef NV
layout(binding = 10, rg8) uniform writeonly image2D oC1;
#else
layout(binding = 10, r8) uniform writeonly image2D oC1;
layout(binding = 11, r8) uniform writeonly image2D oC2;
#endif
#endif

#define NC 5

int bw, bh;

vec4 illum_at(ivec2 q0, int bxA, int byA)
{
    vec4 s = vec4(0.0);
    for (int k = 0; k < 4; k++) {
        ivec2 b = ivec2(bxA + (k & 1), byA + (k >> 1));
        vec2 w = max(vec2(0.0), 1.0 - abs(vec2(q0) + 0.5 - vec2(b * 8) - 3.5) / 8.0);
        s += w.x * w.y * vec4(ill[bidx(b, ivec2(bw, bh))].xyz, 1.0);
    }
    return s / max(s.w, 1e-6);
}

struct Cub {
    vec2 base, h, w0, w3, w12;
    float nrm;
    bool zero;
};

Cub cw_setup(vec2 pos)
{
    Cub c;
    c.base = floor(pos - 0.5) + 0.5;
    vec2 f = pos - c.base;
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    c.w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    c.w3 = f * f * (-0.5 + 0.5 * f);
    c.w12 = 1.0 + f * f * (-2.5 + 1.5 * f) + w2;
    c.h = w2 / c.w12;
    c.nrm = 1.0 / (c.w12.x * (c.w0.y + c.w12.y + c.w3.y) + c.w12.y * (c.w0.x + c.w3.x));
    c.zero = f == vec2(0.0);
    return c;
}

vec2 csamp(sampler2D T, Cub c, vec2 d, vec2 inv, bool two)
{
    vec2 t1 = c.base + d;
    if (c.zero)
        return texelFetch(T, clamp(ivec2(floor(t1)), ivec2(0), textureSize(T, 0) - 1), 0).rg;
    vec2 t0 = (t1 - 1.0) * inv, t3 = (t1 + 2.0) * inv, t12 = (t1 + c.h) * inv, tc = (t1 + 0.5) * inv;
    vec4 g0 = textureGather(T, tc, 0), g1 = two ? textureGather(T, tc, 1) : g0;
    vec2 ctr = vec2(mix(mix(g0.w, g0.z, c.h.x), mix(g0.x, g0.y, c.h.x), c.h.y),
                    mix(mix(g1.w, g1.z, c.h.x), mix(g1.x, g1.y, c.h.x), c.h.y));
    vec2 v = (textureLod(T, vec2(t12.x, t0.y), 0.0).rg * (c.w12.x * c.w0.y) +
              textureLod(T, vec2(t0.x, t12.y), 0.0).rg * (c.w0.x * c.w12.y) + ctr * (c.w12.x * c.w12.y) +
              textureLod(T, vec2(t3.x, t12.y), 0.0).rg * (c.w3.x * c.w12.y) +
              textureLod(T, vec2(t12.x, t3.y), 0.0).rg * (c.w12.x * c.w3.y)) * c.nrm;
    vec2 lo = vec2(min(min(g0.x, g0.y), min(g0.z, g0.w)), min(min(g1.x, g1.y), min(g1.z, g1.w)));
    vec2 hi = vec2(max(max(g0.x, g0.y), max(g0.z, g0.w)), max(max(g1.x, g1.y), max(g1.z, g1.w)));
    return clamp(v, lo, hi);
}

vec4 crw(float f)
{
    return vec4(f * (-0.5 + f * (1.0 - 0.5 * f)), 1.0 + f * f * (-2.5 + 1.5 * f), f * (0.5 + f * (2.0 - 1.5 * f)),
                f * f * (-0.5 + 0.5 * f));
}

void quad_cubic(sampler2D T, vec2 pos, vec2 inv, out float o[4])
{
    vec2 k = floor(pos - 0.5), f = pos - 0.5 - k;
    if (f == vec2(0.0)) {
        ivec2 lim = textureSize(T, 0) - 1;
        for (int j = 0; j < 4; j++)
            o[j] = texelFetch(T, clamp(ivec2(k) + ivec2(j & 1, j >> 1), ivec2(0), lim), 0).r;
        return;
    }
    vec4 wx = crw(f.x), wy = crw(f.y);
    float hv[5][2], in3[3][3];
    for (int gy = 0; gy < 3; gy++) {
        vec4 g0 = textureGather(T, (k + vec2(0.0, float(2 * gy))) * inv, 0);
        vec4 g1 = textureGather(T, (k + vec2(2.0, float(2 * gy))) * inv, 0);
        vec4 g2 = textureGather(T, (k + vec2(4.0, float(2 * gy))) * inv, 0);
        float r[2][6] = float[2][6](float[6](g0.w, g0.z, g1.w, g1.z, g2.w, g2.z), float[6](g0.x, g0.y, g1.x, g1.y, g2.x, g2.y));
        for (int rr = 0; rr < 2; rr++) {
            int row = 2 * gy + rr;
            if (row > 4)
                continue;
            for (int jx = 0; jx < 2; jx++)
                hv[row][jx] = dot(wx, vec4(r[rr][jx], r[rr][jx + 1], r[rr][jx + 2], r[rr][jx + 3]));
            if (row >= 1 && row <= 3)
                for (int c = 0; c < 3; c++)
                    in3[row - 1][c] = r[rr][c + 1];
        }
    }
    for (int j = 0; j < 4; j++) {
        int jx = j & 1, jy = j >> 1;
        float v = dot(wy, vec4(hv[jy][jx], hv[jy + 1][jx], hv[jy + 2][jx], hv[jy + 3][jx]));
        float lo = min(min(in3[jy][jx], in3[jy][jx + 1]), min(in3[jy + 1][jx], in3[jy + 1][jx + 1]));
        float hi = max(max(in3[jy][jx], in3[jy][jx + 1]), max(in3[jy + 1][jx], in3[jy + 1][jx + 1]));
        o[j] = clamp(v, lo, hi);
    }
}

float outq(float v)
{
#ifdef DEPTH16
    v = min(v, pc.f2.y);
    if (pc.f2.z > 0.0)
        v = round(v / pc.f2.z) * pc.f2.z;
#endif
    return v;
}

float okf(int which, vec2 p, vec2 u, float thr)
{
    vec2 q = (p - 3.5) / 8.0;
    ivec2 b0 = ivec2(floor(q));
    vec2 fr = q - vec2(b0);
    float s = 0.0;
    for (int k = 0; k < 4; k++) {
        int i = bidx(b0 + ivec2(k & 1, k >> 1), ivec2(bw, bh));
        vec2 v = which == 0 ? fa[i].xy - u : fb[i].xy + u;
        float w = ((k & 1) != 0 ? fr.x : 1.0 - fr.x) * ((k >> 1) != 0 ? fr.y : 1.0 - fr.y);
        s += l1(v) <= thr ? w : 0.0;
    }
    return s;
}

void main()
{
    int W = pc.i0.x, H = pc.i0.y;
    bw = pc.i0.z;
    bh = pc.i0.w;
    ivec2 q0 = ivec2(gl_GlobalInvocationID.xy) * 2;
    if (q0.x >= W || q0.y >= H)
        return;
    float t = pc.f0.x;
    vec2 inv = 1.0 / vec2(W, H);
    if (stat[2] != 0u) {
        bool useA = t < 0.5;
        for (int j = 0; j < 4; j++) {
            ivec2 p = q0 + ivec2(j & 1, j >> 1);
            if (p.x < W && p.y < H)
                imageStore(oY, p, vec4(useA ? texelFetch(AY, p, 0).r : texelFetch(BY, p, 0).r));
        }
        for (int cy = 0; cy < (2 >> pc.i1.w); cy++)
            for (int cx = 0; cx < (2 >> pc.i1.z); cx++) {
                ivec2 cp = (q0 >> pc.i1.zw) + ivec2(cx, cy);
                if (cp.x >= pc.i1.x || cp.y >= pc.i1.y)
                    continue;
#ifdef NV
                imageStore(oC1, cp, useA ? texelFetch(AC1, cp, 0) : texelFetch(BC1, cp, 0));
#else
                imageStore(oC1, cp, useA ? texelFetch(AC1, cp, 0) : texelFetch(BC1, cp, 0));
                imageStore(oC2, cp, useA ? texelFetch(AC2, cp, 0) : texelFetch(BC2, cp, 0));
#endif
            }
        return;
    }
    int qx = q0.x >> 2, qy = q0.y >> 2;
    int bxA = (qx & 1) != 0 ? qx / 2 : qx / 2 - 1;
    int byA = (qy & 1) != 0 ? qy / 2 : qy / 2 - 1;

    vec2 cu[NC];
    int cm[NC];
    float cw[NC][4];
    float fbs[4] = float[4](0.0, 0.0, 0.0, 0.0), fbn[4] = float[4](0.0, 0.0, 0.0, 0.0);
    int nc = 0;
    bool hasm = false;
    for (int k = 0; k < 4; k++) {
        ivec2 b = ivec2(bxA + (k & 1), byA + (k >> 1));
        int bi = bidx(b, ivec2(bw, bh));
        ivec2 sc = clamp(b * 2 + clamp((q0 - b * 8) >> 2, ivec2(0), ivec2(1)), ivec2(0), ivec2(bw, bh) * 2 - 1);
        vec4 tv = tf[sc.y * bw * 2 + sc.x];
        vec2 u = tv.xy;
        int md = int(tv.z);
        int ci = -1;
        for (int i = 0; i < nc; i++)
            if (cu[i] == u)
                ci = i;
        if (ci < 0) {
            ci = nc++;
            cu[ci] = u;
            cm[ci] = md;
            hasm = hasm || md == M_UNC;
            for (int j = 0; j < 4; j++)
                cw[ci][j] = 0.0;
        }
        vec2 cb = vec2(b * 8) + 3.5;
        for (int j = 0; j < 4; j++) {
            vec2 p = vec2(q0 + ivec2(j & 1, j >> 1));
            vec2 w2 = max(vec2(0.0), 1.0 - abs(p - cb) / 8.0);
            cw[ci][j] += w2.x * w2.y;
            fbs[j] += w2.x * w2.y * fbw[bi];
            fbn[j] += w2.x * w2.y;
        }
    }
    vec4 il = illum_at(q0, bxA, byA);
    float dy = il.x;
    float dcl = dy * 255.0 * pc.f2.x;
    int fbi = nc++;
    cu[fbi] = vec2(0.0);
    cm[fbi] = 0;
    for (int j = 0; j < 4; j++)
        cw[fbi][j] = 1.0 - pc.f1.y;

    float cost[NC][4];
    uint am[4] = uint[4](0u, 0u, 0u, 0u);
    for (int i = 0; i < nc; i++) {
        vec2 u = cu[i];
        vec2 oa = -t * u, ob = (1.0 - t) * u;
        float thr = cons_thr(pc.f1.z, u);
        vec2 pq = vec2(q0) + 0.5;
        float sA = 0.0, sB = 0.0;
        if (cm[i] != 0) {
            sA = float(cm[i] == M_PAST);
            sB = float(cm[i] == M_FUT || cm[i] == M_UNC);
        } else if (i != fbi) {
            sA = okf(0, pq + oa, u, thr);
            sB = okf(1, pq + ob, u, thr);
        }
        bool fb = i == fbi;
        float D[16];
        for (int y = 0; y < 4; y++)
            for (int x = 0; x < 4; x++) {
                vec2 p = vec2(q0 + ivec2(x - 1, y - 1)) + 0.5;
#ifdef DEPTH16
                float a = textureLod(AL, (p + oa) * inv, 0.0).r;
                float b = textureLod(BL, (p + ob) * inv, 0.0).r;
#else
                float a = textureLod(AY, (p + oa) * inv, 0.0).r;
                float b = textureLod(BY, (p + ob) * inv, 0.0).r;
#endif
                D[y * 4 + x] = abs((a - b) * 255.0 - dcl);
            }
        for (int j = 0; j < 4; j++) {
            int jx = j & 1, jy = j >> 1;
            float cst;
            uint al = 0u;
            float e = 0.0;
            for (int dy = 0; dy < 3; dy++)
                for (int dx = 0; dx < 3; dx++)
                    e += D[(jy + dy) * 4 + jx + dx];
            if (fb) {
                cst = hasm ? pc.f1.w : pc.f1.x;
            } else {
                float qa = round(sA * (1.0 - sB) * 7.0), qb = round((1.0 - sA) * sB * 7.0);
                cst = sA * sB * max(0.0, e - pc.f3.x * clamp(l1(u) * 0.5, 0.0, 1.0)) +
                      (qa + qb) / 7.0 * pc.f0.z + (1.0 - sA) * (1.0 - sB) * (e + pc.f0.w);
                if (pc.f3.z > 0.0) {
                    float dm = 1e30;
                    for (int dy = 0; dy < 3; dy++)
                        for (int dx = 0; dx < 3; dx++)
                            dm = min(dm, D[(jy + dy) * 4 + jx + dx]);
                    float s7 = round(smoothstep(pc.f3.y, pc.f3.z, dm) * smoothstep(0.0, 0.25, sA * sB) * 7.0);
                    float q0 = qa + qb;
                    if (t < 0.5) {
                        qa = max(qa, s7);
                        qb = min(qb, 7.0 - qa);
                    } else {
                        qb = max(qb, s7);
                        qa = min(qa, 7.0 - qb);
                    }
                    cst += max(0.0, qa + qb - q0) / 7.0 * pc.f0.z;
                }
                al = uint(qa) | (uint(qb) << 3);
            }
            cost[i][j] = cst;
            am[j] |= al << (6 * i);
        }
    }
    float wA[NC][4], wB[NC][4];
    for (int j = 0; j < 4; j++) {
        float mc = 1e30;
        for (int i = 0; i < nc; i++)
            mc = min(mc, cost[i][j]);
        float sw = 0.0, wt[NC];
        for (int i = 0; i < nc; i++) {
            float e = exp(-(cost[i][j] - mc) / pc.f0.y);
            wt[i] = e < 4.9e-4 ? 0.0 : (pc.f1.y + cw[i][j]) * e;
            sw += wt[i];
        }
        float f = fbn[j] > 0.0 ? fbs[j] / fbn[j] : 0.0;
        for (int i = 0; i < nc; i++) {
            float w = (1.0 - f) * wt[i] / sw + (i == fbi ? f : 0.0);
            uint c = (am[j] >> (6 * i)) & 63u;
            float qa = float(c & 7u) / 7.0, qb = float(c >> 3) / 7.0;
            float al = t * (1.0 - qa - qb) + qb;
            wA[i][j] = w * (1.0 - al);
            wB[i][j] = w * al;
        }
    }
    float acc4[4] = float[4](0.0, 0.0, 0.0, 0.0);
    for (int i = 0; i < nc; i++) {
        if (wA[i][0] + wB[i][0] + wA[i][1] + wB[i][1] + wA[i][2] + wB[i][2] + wA[i][3] + wB[i][3] <= 0.0)
            continue;
        float sa[4], sb[4];
        quad_cubic(AY, vec2(q0) + 0.5 - t * cu[i], inv, sa);
        quad_cubic(BY, vec2(q0) + 0.5 + (1.0 - t) * cu[i], inv, sb);
        for (int j = 0; j < 4; j++)
            acc4[j] += wA[i][j] * (sa[j] - t * dy) + wB[i][j] * (sb[j] + (1.0 - t) * dy);
    }
    for (int j = 0; j < 4; j++) {
        ivec2 p = q0 + ivec2(j & 1, j >> 1);
        if (p.x < W && p.y < H)
            imageStore(oY, p, vec4(outq(acc4[j])));
    }

    vec2 dcc = il.yz;
    int sx = pc.i1.z, sy = pc.i1.w;
    int CW = pc.i1.x, CH = pc.i1.y;
    vec2 cinv = 1.0 / vec2(CW, CH);
    vec2 cs = vec2(1 << sx, 1 << sy);
    for (int cy = 0; cy < (2 >> sy); cy++)
        for (int cx = 0; cx < (2 >> sx); cx++) {
            ivec2 cp = (q0 >> ivec2(sx, sy)) + ivec2(cx, cy);
            if (cp.x >= CW || cp.y >= CH)
                continue;
            vec2 pc2 = vec2(cp) + 0.5;
            vec4 acc = vec4(0.0);
            float nrm = 1.0 / float((1 << sx) * (1 << sy));
            for (int i = 0; i < nc; i++) {
                float ca = 0.0, cb = 0.0;
                for (int yy = 0; yy < (1 << sy); yy++)
                    for (int xx = 0; xx < (1 << sx); xx++) {
                        int j = ((cy << sy) + yy) * 2 + (cx << sx) + xx;
                        ca += wA[i][j];
                        cb += wB[i][j];
                    }
                ca *= nrm;
                cb *= nrm;
                if (ca + cb <= 0.0)
                    continue;
                Cub xa = cw_setup(pc2 - t * cu[i] / cs), xb = cw_setup(pc2 + (1.0 - t) * cu[i] / cs);
#ifdef NV
                vec2 a = csamp(AC1, xa, vec2(0.0), cinv, true), b = csamp(BC1, xb, vec2(0.0), cinv, true);
#else
                vec2 a = vec2(csamp(AC1, xa, vec2(0.0), cinv, false).x, csamp(AC2, xa, vec2(0.0), cinv, false).x);
                vec2 b = vec2(csamp(BC1, xb, vec2(0.0), cinv, false).x, csamp(BC2, xb, vec2(0.0), cinv, false).x);
#endif
                acc.xy += ca * (a - t * dcc) + cb * (b + (1.0 - t) * dcc);
            }
#ifdef NV
            imageStore(oC1, cp, vec4(outq(acc.x), outq(acc.y), 0.0, 0.0));
#else
            imageStore(oC1, cp, vec4(outq(acc.x)));
            imageStore(oC2, cp, vec4(outq(acc.y)));
#endif
        }
}
