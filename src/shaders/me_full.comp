#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 256) in;
layout(binding = 0) uniform sampler2D X;
layout(binding = 1) uniform sampler2D Y;
layout(std430, binding = 2) writeonly buffer Out { vec4 o[]; };

#define MAXR 16
#define MAXS (16 + 2 * MAXR)
shared float sx[256];
shared float sy[MAXS * MAXS];
shared float rc[256];
shared int ri[256];

void main()
{
    int bw = pc.i0.x, lw = pc.i0.z, lh = pc.i0.w;
    int R = min(pc.i1.x, MAXR), S = 16 + 2 * R, D = 2 * R + 1;
    int tid = int(gl_LocalInvocationIndex);
    int blk = int(gl_WorkGroupID.x);
    int bx = blk % bw, by = blk / bw;
    int x0 = bx * 8 - 4, y0 = by * 8 - 4;
    ivec2 mx = ivec2(lw - 1, lh - 1);
    sx[tid] = texelFetch(X, clamp(ivec2(x0 + tid % 16, y0 + tid / 16), ivec2(0), mx), 0).r * 255.0;
    for (int i = tid; i < S * S; i += 256)
        sy[i] = texelFetch(Y, clamp(ivec2(x0 - R + i % S, y0 - R + i / S), ivec2(0), mx), 0).r * 255.0;
    barrier();
    float best = 1e30;
    int bi = 0;
    for (int c = tid; c < D * D; c += 256) {
        int vx = c % D, vy = c / D;
        float s = 0.0;
        for (int y = 0; y < 16; y++)
            for (int x = 0; x < 16; x++)
                s += abs(sx[y * 16 + x] - sy[(y + vy) * S + x + vx]);
        s += pc.f0.x * float(abs(vx - R) + abs(vy - R));
        if (s < best) {
            best = s;
            bi = c;
        }
    }
    rc[tid] = best;
    ri[tid] = bi;
    barrier();
    for (int st = 128; st > 0; st >>= 1) {
        if (tid < st && (rc[tid + st] < rc[tid] || (rc[tid + st] == rc[tid] && ri[tid + st] < ri[tid]))) {
            rc[tid] = rc[tid + st];
            ri[tid] = ri[tid + st];
        }
        barrier();
    }
    int vx = ri[0] % D, vy = ri[0] / D;
    float cost = rc[0];
    barrier();
    rc[tid] = sx[tid] - sy[(tid / 16 + vy) * S + tid % 16 + vx];
    barrier();
    for (int st = 128; st > 0; st >>= 1) {
        if (tid < st)
            rc[tid] += rc[tid + st];
        barrier();
    }
    if (tid == 0)
        o[blk] = vec4(float(vx - R), float(vy - R), cost, rc[0] / 256.0);
}
