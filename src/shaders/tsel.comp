#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_KHR_shader_subgroup_clustered : enable
#include "common.glsl"
#include "sad.glsl"
layout(local_size_x = 64) in;
layout(binding = 0) uniform sampler2D A;
layout(binding = 1) uniform sampler2D B;
layout(binding = 2) uniform sampler2D C;
layout(binding = 3) uniform sampler2D Z;
layout(std430, binding = 4) readonly buffer FA { vec4 fa[]; };
layout(std430, binding = 5) readonly buffer FB { vec4 fb[]; };
layout(std430, binding = 6) readonly buffer Keys { uint keys[]; };
layout(std430, binding = 7) readonly buffer TPrev { vec4 tp[]; };
layout(std430, binding = 8) writeonly buffer TOut { vec4 to[]; };
layout(std430, binding = 9) readonly buffer NFA { vec4 nfa[]; };
layout(std430, binding = 10) readonly buffer PFB { vec4 pfb[]; };
layout(std430, binding = 11) readonly buffer SN { uint sn[]; };
layout(std430, binding = 12) readonly buffer SP { uint sp[]; };
layout(std430, binding = 13) readonly buffer Ext { uint ek[]; };

int bw, bh;

vec2 fat(int which, vec2 p)
{
    int i = bidx(ivec2(floor(p / 8.0)), ivec2(bw, bh));
    return which == 0 ? fa[i].xy : which == 1 ? fb[i].xy : which == 2 ? nfa[i].xy : pfb[i].xy;
}

vec2 cl[19];

float zsad_bc(vec2 p, vec2 u, float t)
{
    float rb[16], rc[16];
    row16(B, p + (1.0 - t) * u, rb);
    row16(C, p + (2.0 - t) * u, rc);
    return zsad(rb, rc);
}

float tolf(vec2 u) { return float(pc.i2.x) * 0.01 * l1(u) + float(pc.i2.y) * 0.01; }

bool both_sup(vec2 c, vec2 u, float t)
{
    float tol = tolf(u);
    return l1(fat(3, c - t * u) + u) <= tol && l1(fat(2, c + (1.0 - t) * u) - u) <= tol;
}

float tex16(float r[16], sampler2D T, vec2 p)
{
    float d[16];
    row16(T, p + vec2(0.0, 1.0), d);
    float g = 0.0;
    for (int x = 0; x < 15; x++)
        g += abs(r[x + 1] - r[x]) + abs(d[x] - r[x]);
    return subgroupClusteredAdd(g, 16) * 255.0;
}
int n;

void add(vec2 v)
{
    for (int k = 0; k < n; k++)
        if (cl[k] == v)
            return;
    cl[n++] = v;
}

void main()
{
    bw = pc.i0.x;
    bh = pc.i0.y;
    int lane = int(gl_LocalInvocationID.x) & 15;
    int id = int(gl_WorkGroupID.x) * 4 + (int(gl_LocalInvocationID.x) >> 4);
    if (id >= bw * bh)
        return;
    int bx = id % bw, by = id / bw;
    g_inv = 1.0 / vec2(pc.i0.zw);
    float t = pc.f0.x;
    n = 0;
    for (int i = 0; i < 4; i++) {
        uint key = keys[id * 4 + i];
        if (key == 0xffffffffu)
            break;
        int src = int(key >> 1);
        add((key & 1u) != 0u ? -fb[src].xy : fa[src].xy);
    }
    bool fut = pc.i1.y != 0 && sn[2] == 0u;
    bool past = pc.i1.z != 0 && sp[2] == 0u;
    add(fa[id].xy);
    add(-fb[id].xy);
    if (ek[id * 4] != 0xffffffffu) {
        vec2 cc = vec2(bx * 8 + 4, by * 8 + 4);
        bool nsup = false;
        for (int i = 0; i < n; i++) {
            vec2 u = cl[i];
            float th = cons_thr(pc.f0.z, u);
            nsup = nsup || (past && fut && l1(fat(0, cc - t * u) - u) <= th && l1(fat(1, cc + (1.0 - t) * u) + u) <= th &&
                            both_sup(cc, u, t));
        }
        for (int i = 0; i < 2 && !nsup; i++) {
            uint key = ek[id * 4 + i];
            if (key == 0xffffffffu)
                break;
            int src = int(key >> 1);
            vec2 u = (key & 1u) != 0u ? nfa[src].xy : -pfb[src].xy;
            float th = cons_thr(pc.f0.z, u);
            bool own = (key & 1u) != 0u ? l1(fat(1, cc + (1.0 - t) * u) + u) <= th : l1(fat(0, cc - t * u) - u) <= th;
            if (past && fut && (own || both_sup(cc, u, t)))
                add(u);
        }
    }
    int n2 = n;
    if (pc.i1.x == 0) {
        ivec2 d[4] = ivec2[4](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
        for (int k = 0; k < 4; k++) {
            int q = bidx(ivec2(bx, by) + d[k], ivec2(bw, bh));
            add(fa[q].xy);
            add(-fb[q].xy);
        }
    } else {
        add(tp[id].xy);
        ivec2 d[8] = ivec2[8](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1),
                              ivec2(-1, -1), ivec2(1, -1), ivec2(-1, 1), ivec2(1, 1));
        for (int k = 0; k < 8; k++) {
            add(tp[bidx(ivec2(bx, by) + d[k], ivec2(bw, bh))].xy);
        }
    }
    vec2 row0 = vec2(bx * 8 - 4, by * 8 - 4 + lane) + 0.5;
    vec2 c = vec2(bx * 8 + 4, by * 8 + 4);
    float best_c = 1e30, best_m = 0.0;
    vec2 best_v = vec2(0.0);
    int best_mode = 0;
    int q = nbr3(lane, ivec2(bx, by), ivec2(bw, bh));
    set_dc_w(lane < 9 ? max(abs(fa[q].w), abs(fb[q].w)) : 1e30);
    float cs[8];
    bool anysup = false;
    float minsup = float(pc.i2.w) * 0.01;
    if (pc.i1.w != 0 && past && fut) {
        for (int i = 0; i < n2 && !anysup; i++)
            anysup = l1(cl[i]) >= minsup && both_sup(c, cl[i], t);
    }
    float bs_c = 1e30;
    vec2 bs_v = vec2(0.0);
    bool best_sup = true, best_ok = false;
    for (int i = 0; i < n2; i++) {
        vec2 u = cl[i];
        float ra[16], rb[16];
        row16(A, row0 - t * u, ra);
        row16(B, row0 + (1.0 - t) * u, rb);
        float s = zsad(ra, rb);
        float m2 = g_ml;
        float thr = cons_thr(pc.f0.z, u);
        bool okA = l1(fat(0, c - t * u) - u) <= thr;
        bool okB = l1(fat(1, c + (1.0 - t) * u) + u) <= thr;
        bool sup = true;
        float pen = float(int(!okA) + int(!okB));
        bool chk = anysup && l1(u) >= minsup;
        if (chk) {
            float tol = tolf(u);
            bool ps = l1(fat(3, c - t * u) + u) <= tol, fs = l1(fat(2, c + (1.0 - t) * u) - u) <= tol;
            sup = ps || fs;
            if (ps && fs && pc.i3.z != 0)
                pen = 0.0;
        }
        float cost = s + pc.f0.y * pen;
        if (chk) {
            if (!sup)
                cost += float(pc.i2.z);
            else if (cost < bs_c) {
                bs_c = cost;
                bs_v = u;
            }
        }
        if (okA && okB && sup)
            cost -= pc.f0.w * clamp(l1(u) * 0.5, 0.0, 1.0);
        cs[i] = okB && !okA ? cost : -1.0;
        if (cost < best_c) {
            best_c = cost;
            best_v = u;
            best_m = m2;
            best_sup = sup;
            best_ok = okA && okB;
        }
    }
    if (anysup && !best_sup && bs_c < 1e29 && pc.i3.x > 0) {
        float R = float(pc.i3.x);
        for (int pass = 0; pass < 2; pass++) {
            vec2 base = pass == 0 ? bs_v : best_v;
            float st = pass == 0 ? 2.0 : 1.0, rr = pass == 0 ? R : 1.0;
            for (float dy = -rr; dy <= rr; dy += st)
            for (float dx = -rr; dx <= rr; dx += st) {
                vec2 u = base + vec2(dx, dy);
                float ra[16], rb[16];
                row16(A, row0 - t * u, ra);
                row16(B, row0 + (1.0 - t) * u, rb);
                float s = zsad(ra, rb);
                float m2 = g_ml;
                float thr = cons_thr(pc.f0.z, u);
                bool okA = l1(fat(0, c - t * u) - u) <= thr;
                bool okB = l1(fat(1, c + (1.0 - t) * u) + u) <= thr;
                if (pass == 0 && !okA && !okB)
                    continue;
                float cost = s + pc.f0.y * ((both_sup(c, u, t) && pc.i3.z != 0) ? 0.0 : float(int(!okA) + int(!okB)));
                if (okA && okB)
                    cost -= pc.f0.w * clamp(l1(u) * 0.5, 0.0, 1.0);
                if (cost < best_c) {
                    best_c = cost;
                    best_v = u;
                    best_m = m2;
                }
            }
        }
    }
    if (pc.f2.w > 0.0 && past && fut && best_c > pc.f2.z) {
        float pb = 1e30, pc2;
        vec2 pv;
        for (int i = 0; i < n2; i++) {
            if (cs[i] < 0.0)
                continue;
            float sc = zsad_bc(row0, cl[i], t);
            if (sc < pb && sc < best_c) {
                pb = sc;
                pv = cl[i];
                pc2 = cs[i];
            }
        }
        if (pb < 1e30 && pb <= pc.f3.y * zsad_bc(row0, best_v, t)) {
            best_v = pv;
            best_c = pc2;
            best_mode = M_UNC;
        }
    }
    float lim = pc.f1.w * best_c, best_rel = 1e30;
    if ((fut || past) && lim > pc.f1.z && best_c > pc.f2.x && !best_ok) {
        if (fut)
            add(nfa[id].xy);
        if (past)
            add(-pfb[id].xy);
        float sw = pc.f3.x;
        vec2 fr = vec2(bw - 1, bh - 1) * 8.0;
        for (int i = 0; i < n; i++) {
            vec2 u = cl[i];
            float thr = cons_thr(pc.f0.z, u);
            vec2 pa = c - t * u, pb = c + (1.0 - t) * u;
            float ia = l1(fat(0, pa) - u), ib = l1(fat(1, pb) + u);
            if (ia <= thr && ib <= thr)
                continue;
            bool swf = t >= 0.5 || any(lessThan(pa, vec2(8.0))) || any(greaterThanEqual(pa, fr)) || t * ia >= sw;
            bool swp = t <= 0.5 || any(lessThan(pb, vec2(8.0))) || any(greaterThanEqual(pb, fr)) || (1.0 - t) * ib >= sw;
            if (fut && swf && l1(fat(2, pb) - u) <= thr) {
                float rb[16], rc[16];
                row16(B, row0 + (1.0 - t) * u, rb);
                row16(C, row0 + (2.0 - t) * u, rc);
                float sf = zsad(rb, rc);
                if (sf + pc.f1.z < lim) {
                    float rel = sf / max(tex16(rb, B, row0 + (1.0 - t) * u), 1.0);
                    if (rel < pc.f2.y && rel < best_rel) {
                        best_rel = rel;
                        best_v = u;
                        best_mode = M_FUT;
                    }
                }
            }
            if (past && swp && l1(fat(3, pa) + u) <= thr) {
                float ra[16], rz[16];
                row16(A, row0 - t * u, ra);
                row16(Z, row0 - (1.0 + t) * u, rz);
                float sz = zsad(ra, rz);
                if (sz + pc.f1.z < lim) {
                    float rel = sz / max(tex16(ra, A, row0 - t * u), 1.0);
                    if (rel < pc.f2.y && rel < best_rel) {
                        best_rel = rel;
                        best_v = u;
                        best_mode = M_PAST;
                    }
                }
            }
        }
    }
    float dcm = block_dc(best_m);
    if (lane == 0)
        to[id] = vec4(best_v, float(best_mode), dcm);
}
