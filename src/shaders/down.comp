#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, r16f) uniform writeonly image2D dst;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.i0.xy)))
        return;
    vec2 c = (vec2(p) * 2.0 + 1.0) / vec2(pc.i0.zw);
    imageStore(dst, p, vec4(textureLod(src, c, 0.0).r));
}
