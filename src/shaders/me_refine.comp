#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#define PLAIN_SAD
#include "sad.glsl"
layout(local_size_x = 64) in;
layout(binding = 0) uniform sampler2D X;
layout(binding = 1) uniform sampler2D Y;
layout(std430, binding = 2) buffer F { vec4 f[]; };
layout(std430, binding = 3) buffer Stat { uint stat[]; };

void main()
{
    int bw = pc.i0.x, bh = pc.i0.y;
    int lane = int(gl_LocalInvocationID.x) & 15;
    int id = int(gl_WorkGroupID.x) * 4 + (int(gl_LocalInvocationID.x) >> 4);
    if (id >= bw * bh)
        return;
    g_inv = 1.0 / vec2(pc.i0.zw);
    load_x(X, (id % bw) * 8 - 4, (id / bw) * 8 - 4, lane);
    g_w = smoothstep(pc.f3.z, pc.f3.w, abs(f[id].w));
    vec2 bv = f[id].xy;
    float best = sad_y(Y, bv), best_m = g_ml, best_sad = g_sad, best_z = g_zsad;
    int nk = pc.i1.y == 1 ? 4 : 8;
    for (float st = 0.5; st >= 0.25 && pc.i1.y != 0; st *= 0.5) {
        vec2 c = bv;
        for (int k = 0; k < nk; k++) {
            const ivec2 dirs[8] = ivec2[8](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1),
                                           ivec2(-1, -1), ivec2(1, -1), ivec2(-1, 1), ivec2(1, 1));
            vec2 v = c + vec2(dirs[k]) * st;
            float s = sad_y(Y, v);
            if (s < best) {
                best = s;
                best_m = g_ml;
                best_sad = g_sad;
                best_z = g_zsad;
                bv = v;
            }
        }
    }
    float dcm = block_dc(best_m);
    float bm = pc.i1.z != 0 ? block_sum() * (255.0 / 256.0) : 0.0;
    if (lane == 0) {
        f[id] = vec4(bv, best, dcm);
        if (pc.i1.x != 0) {
            atomicAdd(stat[0], uint(best_sad * (1.0 / 16.0) + 0.5));
            atomicAdd(stat[1], uint(best_z * (1.0 / 16.0) + 0.5));
        }
        if (pc.i1.z != 0) {
            int o = pc.i1.w * 2;
            atomicAdd(stat[3 + o], uint(bm + 0.5));
            atomicAdd(stat[4 + o], uint(bm * bm * (1.0 / 16.0) + 0.5));
        }
    }
}
