#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer NW { vec2 nw[]; };
layout(std430, binding = 1) writeonly buffer O { float o[]; };
layout(std430, binding = 2) readonly buffer TF { vec4 tf[]; };
layout(std430, binding = 3) readonly buffer GM { vec4 gm[]; };

void main()
{
    int bw = pc.i0.x, bh = pc.i0.y, r = pc.i0.z;
    int id = int(gl_GlobalInvocationID.x);
    if (id >= bw * bh)
        return;
    ivec2 b = ivec2(id % bw, id / bw);
    float m = 0.0;
    for (int y = -r; y <= r; y++)
        for (int x = -r; x <= r; x++)
            m = max(m, nw[bidx(b + ivec2(x, y), ivec2(bw, bh))].x);
    float src = 0.0;
    vec2 c = vec2(b * 8) + 4.0, t = vec2(pc.f0.y);
    for (int e = 0; e < 9 && pc.f0.x > 0.0; e++) {
        vec2 u = tf[bidx(b + ivec2(e % 3 - 1, e / 3 - 1), ivec2(bw, bh))].xy;
        if (l1(u - gm[0].xy) <= pc.f0.x)
            continue;
        for (int k = 0; k < 2; k++) {
            ivec2 q = ivec2(floor((c + (k == 0 ? -t : 1.0 - t) * u) / 8.0));
            for (int d = 0; d < 9; d++)
                src = max(src, nw[bidx(q + ivec2(d % 3 - 1, d / 3 - 1), ivec2(bw, bh))].x);
        }
    }
    o[id] = max(max(nw[id].x, m * nw[id].y), src);
}
